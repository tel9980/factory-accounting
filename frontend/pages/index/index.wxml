<view class="page">

  <!-- 本月三数 -->
  <view class="stats">
    <view class="stat">
      <view class="num">{{month_income}}</view>
      <view class="label">本月收入</view>
    </view>
    <view class="stat">
      <view class="num">{{month_expense}}</view>
      <view class="label">本月支出</view>
    </view>
    <view class="stat">
      <view class="num profit">{{month_profit}}</view>
      <view class="label">本月毛利</view>
    </view>
  </view>

  <!-- 首页两件事 -->
  <view class="cards">
    <view class="card warn">
      <view class="num">{{unpaid_total}}</view>
      <view class="label">总欠款（元）</view>
    </view>
    <view class="card">
      <view class="num">{{pending_count}}</view>
      <view class="label">进行中订单</view>
    </view>
  </view>

  <!-- 记一笔 -->
  <view class="section-title">记一笔</view>

  <view class="form">
    <input placeholder="客户名" value="{{customer}}" bindinput="onCustomerInput" />
    <input placeholder="产品名" value="{{item_name}}" bindinput="onItemInput" />
    <input placeholder="加工费（元）" type="digit" value="{{price}}" bindinput="onPriceInput" />
    <button size="mini" type="primary" bindtap="addOrder">保存加工订单</button>
  </view>

  <view class="form">
    <input placeholder="支出金额（元）" type="digit" value="{{expense_amount}}" bindinput="onExpenseAmount" />
    <picker range="{{categories}}" value="{{expense_category_index}}" bindchange="onExpenseCategory">
      <view class="picker">{{expense_category}} ▾</view>
    </picker>
    <input placeholder="备注（可选）" value="{{expense_remark}}" bindinput="onExpenseRemark" />
    <button size="mini" type="warn" bindtap="addExpense">记支出</button>
  </view>

  <!-- 最近订单 -->
  <view class="section-title">最近订单</view>
  <view class="orders">
    <view class="order" wx:for="{{orders}}" wx:key="id">
      <view class="row1">
        <text class="cust">{{item.customer}}</text>
        <text class="status">{{item.status_text}}</text>
      </view>
      <view class="row2">{{item.item_name}} · 加工费 {{item.price}} 元</view>
      <view class="row3">
        <text class="pay">已收 {{item.paid}} · 欠 {{item.unpaid}}</text>
        <view class="btns">
          <button size="mini" wx:if="{{item.status < 2 && item.unpaid > 0}}"
            data-id="{{item.id}}" data-unpaid="{{item.unpaid}}" bindtap="payFull">收款</button>
          <button size="mini" type="primary" wx:if="{{item.status < 2}}"
            data-id="{{item.id}}" bindtap="finishOrder">交付</button>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{orders.length === 0}}">还没有订单，先记一笔吧</view>
  </view>

</view>
