            <view class="row2" wx:if="{{item.unpaid>0}}">还没收 {{item.unpaid}} 元</view>
          </view>
        </view>
        <view class="tip" wx:if="{{mb.worst.length}}">最不赚钱：{{mb.worst[0].name}}（毛利 {{mb.worst[0].profit}}，毛利率 {{mb.worst[0].margin_pct}}%）</view>
      </view>
      <view class="tip" wx:else>点「查一下」看这个月哪个客户 / 哪个产品最赚钱。录入应收时填了成本才算得准；不填就按 0 成本算，毛利会偏高。</view>
    </view>

    <view class="form">
      <view class="tip">💰 现金流水账（这个月钱怎么变的：月初多少、进多少、出多少、月底多少）</view>
      <view class="frow">
        <input class="inp" placeholder="月份 YYYY-MM（留空本月）" value="{{cb_month}}" bindinput="onCbMonth" bindconfirm="loadCashbook"/>
        <button class="btn half" size="mini" bindtap="loadCashbook">看现金账</button>
      </view>
      <block wx:if="{{cb}}">
        <view class="box">
