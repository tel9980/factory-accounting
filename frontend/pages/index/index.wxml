      <view class="kpi-row" wx:if="{{inv_sum.in}}"><text>本月收到</text><text class="kpi-n">{{inv_sum.in.amount}} 元 / {{inv_sum.in.count}} 张（税 {{inv_sum.in.tax}}）</text></view>
      <view class="duesoon" wx:if="{{inv_uninv.count>0}}">有 {{inv_uninv.count}} 张已收款的单还没开发票（金额 {{inv_uninv.amount}}）</view>
      <input class="inp" placeholder="发票号（可不填）" value="{{inv_no}}" bindinput="onInvNo"/>
      <input class="inp" placeholder="{{inv_type=='out' ? '客户名称' : '供应商名称'}}" value="{{inv_party}}" bindinput="onInvParty"/>
      <input class="inp" placeholder="开票金额（含税）" type="digit" value="{{inv_amount}}" bindinput="onInvAmount"/>
      <view class="amts"><view class="amtx" wx:for="{{amts}}" wx:key="*this" bindtap="fillAmt" data-f="inv_amount" data-v="{{item}}">{{item}}</view></view>
      <input class="inp" placeholder="其中税额（可不填）" type="digit" value="{{inv_tax}}" bindinput="onInvTax"/>
      <input class="inp" placeholder="开票日期，如 2026-11-10 或 11-10（不填=今天）" value="{{inv_date}}" bindinput="onInvDate"/>
      <view class="chips">
        <text class="chip-label">日期快键：</text>
        <text class="chip" data-f="inv_date" data-n="0" bindtap="quickDate">今天</text>
        <text class="chip" data-f="inv_date" data-n="1" bindtap="quickDate">昨天</text>
        <text class="chip" data-f="inv_date" data-n="2" bindtap="quickDate">前天</text>
      </view>
      <input class="inp" placeholder="备注（可不填）" value="{{inv_remark}}" bindinput="onInvRemark"/>
      <button class="btn" size="mini" bindtap="addInvoice">记一张发票</button>
      <view class="tip">发票只做台账，不影响收支和利润（免得一笔钱算两次）。</view>
      <button class="btn" size="mini" bindtap="loadInvoiceTodo">🧾 该开还没开的票（一键开）</button>

      <view class="prev" wx:if="{{itd}}">
        <view class="prev-h">{{itd.text}}</view>
        <view class="tip">按单子算：已收多少、已经开了多少，差多少就是待开。客户不要票的点「不要票」，就不再提醒。</view>
        <view class="prev-row" wx:for="{{itd.rows}}" wx:key="order_id">
          <text class="prev-t">{{item.party}} · {{item.item}}</text>
          <text class="prev-n">{{item.date}} 开单 · 已收 {{item.paid}} · 已开 {{item.invoiced}} → 待开 {{item.todo}}</text>
          <text class="row2">税 {{item.rate*100}}% ≈ {{item.tax}} 元（不含税 {{item.net}}）</text>
          <view class="frow">
            <button class="btn" size="mini" data-i="{{index}}" bindtap="openInvFromOrder">开这张</button>
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="copyInvTodoOne">复制开票信息</button>
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="skipInvoice">不要票</button>
          </view>
        </view>
        <view class="frow">
          <button class="btn ghost" size="mini" wx:if="{{itd.count}}" bindtap="copyInvTodoAll">复制全部</button>
          <button class="btn ghost" size="mini" bindtap="closeInvoiceTodo">收起</button>
        </view>
      </view>
    </view>

    <view class="form">
      <view class="tip">钱和票对一下（收了钱没开票 / 开了票钱没到）</view>
      <input class="inp" placeholder="月份，如 2026-11（留空=本月）" value="{{ic_month}}" bindinput="onIcMonth"/>
      <button class="btn" size="mini" bindtap="loadInvoiceCheck">🧾 钱和票对一下</button>
    </view>
    <view class="list" wx:if="{{ic}}">
      <view class="item">
        <view class="row1"><text class="nm">本月接单</text><text class="amt">¥{{ic.order_sum}}</text></view>
        <view class="row2">收到 ¥{{ic.paid_sum}} · 开票 {{ic.inv_count}} 张 ¥{{ic.inv_sum}}{{ic.tax_sum>0 ? '（税额 ' + ic.tax_sum + '）' : ''}}</view>
        <view class="row2">差额：{{ic.gap==0 ? '收的钱和开的票对得上 ✓' : (ic.gap>0 ? '收了没开票 ¥' + ic.gap : '多开了票 ¥' + (0-ic.gap))}}</view>
        <view class="row2" wx:if="{{ic.no_invoice.count}}">❗ 收了钱没开票 {{ic.no_invoice.count}} 笔 ¥{{ic.no_invoice.amount}}</view>
        <view class="row2" wx:for="{{ic.no_invoice.list}}" wx:key="id" bindtap="openOrderFromPrice" data-id="{{item.id}}">· {{item.party}} {{item.item}} 已收 ¥{{item.paid}} / 共 ¥{{item.price}}</view>
        <view class="row2" wx:if="{{ic.part_invoice.count}}">✂ 开了部分票 {{ic.part_invoice.count}} 笔，还差 ¥{{ic.part_invoice.amount}}</view>
        <view class="row2" wx:for="{{ic.part_invoice.list}}" wx:key="id" bindtap="openOrderFromPrice" data-id="{{item.id}}">· {{item.party}} 已开 ¥{{item.inv_amount}} / 共 ¥{{item.price}}</view>
        <view class="row2" wx:if="{{ic.inv_no_money.count}}">💰 开了票钱没到 {{ic.inv_no_money.count}} 笔 ¥{{ic.inv_no_money.amount}}</view>
        <view class="row2" wx:for="{{ic.inv_no_money.list}}" wx:key="id" bindtap="openOrderFromPrice" data-id="{{item.id}}">· {{item.party}} 票 ¥{{item.inv_amount}} / 已收 ¥{{item.paid}}</view>
        <view class="row2">{{ic.advice}}</view>
        <view class="btns">
          <button size="mini" bindtap="copyInvoiceCheck">📋 复制给会计</button>
          <button size="mini" bindtap="closeInvoiceCheck">收起</button>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{errs.inv}}">⚠️ 没拉出来（不是没有）· 点这里重试<text class="cfl" bindtap="loadInvoices">　重试</text></view>
    <view class="list" wx:if="{{inv_rows.length}}">
      <view class="item" wx:for="{{inv_rows}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.type=='out' ? '开出' : '收到'}} · {{item.party}}</text><text class="amt">¥{{item.amount}}</text></view>
        <view class="row2">{{item.no ? item.no + ' · ' : ''}}税额 {{item.tax}} · {{item.date}}{{item.remark ? ' · ' + item.remark : ''}}</view>
        <view class="btns"><button size="mini" bindtap="delInvoice" data-id="{{item.id}}">删</button></view>
      </view>
    </view>

    <view class="form">
      <view class="tip">设备摊销（固定资产折旧；在用 {{asset_rows.length}} 台：原值合计 {{asset_cost_total}}，每月摊销 {{asset_monthly}}，现在值 {{asset_net}}）</view>
      <view class="aline warn" wx:if="{{asset_sold_count>0}}">已处置 {{asset_sold_count}} 台，卖了 {{asset_sold_amount}}，{{asset_sold_gain>=0 ? '合计赚 ' : '合计亏 '}}{{asset_sold_gain>=0 ? asset_sold_gain : -asset_sold_gain}} 元（摊销已停）</view>
      <input class="inp" placeholder="设备名称，如 数控车床" value="{{asset_name}}" bindinput="onAssetName"/>
      <input class="inp" placeholder="原值（买入价）" type="digit" value="{{asset_cost}}" bindinput="onAssetCost"/>
      <view class="amts"><view class="amtx" wx:for="{{amts_big}}" wx:key="*this" bindtap="fillAmt" data-f="asset_cost" data-v="{{item}}">{{item}}</view></view>
      <input class="inp" placeholder="买入日期，如 2025-06-01" value="{{asset_buy}}" bindinput="onAssetBuy"/>
      <view class="chips">
        <text class="chip-label">日期快键：</text>
        <text class="chip" data-f="asset_buy" data-n="0" bindtap="quickDate">今天</text>
        <text class="chip" data-f="asset_buy" data-n="1" bindtap="quickDate">昨天</text>
        <text class="chip" data-f="asset_buy" data-n="2" bindtap="quickDate">前天</text>
      </view>
      <input class="inp" placeholder="用几年（不填=5 年）" type="digit" value="{{asset_life}}" bindinput="onAssetLife"/>
      <input class="inp" placeholder="残值率 %（不填=5）" type="digit" value="{{asset_res}}" bindinput="onAssetRes"/>
      <input class="inp" placeholder="几保一次（月），不填=不提醒" type="digit" value="{{asset_maint}}" bindinput="onAssetMaint"/>
      <button class="btn" size="mini" bindtap="addAsset">加一台设备</button>
      <button class="btn-ghost" size="mini" bindtap="runDepreciation">立即计提本月摊销（记一笔支出）</button>
      <view class="tip">直线法：每月摊销 =（原值 − 残值）÷ 使用月数；计提后才进成本，不点就不会自动扣。</view>
      <view class="frow">
        <button class="btn ghost" size="mini" bindtap="loadAssetMaint">🔧 哪些设备该保养了</button>
      </view>
      <block wx:if="{{am}}">
        <view class="box">
          <view class="row1"><text class="nm">设备保养</text><text class="amt {{am.overdue?'red':''}}">{{am.count}} 台</text></view>
          <view class="row2">{{am.advice}}</view>
        </view>
        <view class="item" wx:for="{{am.rows}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt {{item.left_days<0?'red':''}}">{{item.left_days<0?'已超 '+(-item.left_days)+' 天':item.left_days+' 天后'}}</text></view>
          <view class="row2">每 {{item.months}} 个月一次 · 上次 {{item.base_day}} · 下次 {{item.next_day}}</view>
          <view class="btns"><button size="mini" bindtap="doMaint" data-id="{{item.id}}" data-m="{{item.months}}">保养了</button></view>
        </view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyAssetMaint">📋 复制</button>
          <button class="btn ghost" size="mini" bindtap="closeAssetMaint">收起</button>
        </view>
      </block>
    </view>
    <view class="empty" wx:if="{{errs.asset}}">⚠️ 没拉出来（不是没有）· 点这里重试<text class="cfl" bindtap="loadAssets">　重试</text></view>
    <view class="list" wx:if="{{asset_rows.length}}">
      <view class="item" wx:for="{{asset_rows}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">净值 ¥{{item.net}}</text></view>
        <view class="row2">原值 {{item.cost}} · 月摊销 {{item.monthly}} · 已摊 {{item.used_months}} 个月{{item.done ? ' · 已摊完' : ' · 还剩 ' + item.remain_months + ' 个月'}}</view>
        <view class="row2" wx:if="{{item.disposed}}">已处置（{{item.disposed_at}}）卖了 {{item.dispose_amount}} 元，{{item.gain>=0 ? '赚' : '亏'}} {{item.gain>=0 ? item.gain : -item.gain}} 元</view>
        <view class="btns">
          <button size="mini" wx:if="{{!item.disposed && role!='staff'}}" bindtap="disposeAsset" data-id="{{item.id}}">卖掉/报废</button>
          <button size="mini" bindtap="delAsset" data-id="{{item.id}}">删</button>
        </view>
      </view>
    </view>

    <view class="form">
      <view class="tip">银行流水对账（把银行卡/微信账单粘进来，再一笔笔认领成账）</view>
            <view class="tip">认得出的格式：微信/支付宝导出的 CSV（有表头那种）、银行流水的借方/贷方表、以及「日期,收/付,金额,摘要」一行一笔。粘进来不用管列的顺序。</view>
<textarea class="restore-ta" placeholder="{{bank_hint}}" value="{{bank_text}}" bindinput="onBankText"></textarea>
      <view class="tip" wx:if="{{bank_layout}}">✓ 认出这是「{{bank_layout}}」{{bank_skip ? '，跳过 ' + bank_skip + ' 笔不计收支/退款的' : ''}}</view>
      <button class="btn" size="mini" bindtap="importBank">导入流水</button>
      <button class="btn ghost" size="mini" bindtap="importBankFile">📄 或者直接选 Excel 账单文件</button>
      <view class="duesoon" wx:if="{{bank_unmatched.count>0}}">{{bank_unmatched.count}} 笔还没认领，合计 ¥{{bank_unmatched.amount}}</view>
      <view class="frow" wx:if="{{bank_unmatched.count>0}}">
        <button class="btn" size="mini" bindtap="autoMatchBank">🤖 自动认领</button>
        <button class="btn ghost" size="mini" bindtap="closeBankAuto">收起</button>
      </view>
      <view class="tip">认领＝把这笔钱记到账上（抵某张应收/应付，或当成一笔支出），重复的点会提示。</view>
      <view class="bankauto" wx:if="{{ba}}">
        <view class="row1"><text class="nm">{{ba.text}}</text></view>
        <view class="aline" wx:for="{{ba.rows}}" wx:key="id">
          <text>{{item.date.slice(5)}} {{item.direction=='in'?'收':'付'}} ¥{{item.amount}}　{{item.memo}}</text>
          <text class="aline-note">→ {{item.conf=='high'?'能自动认领':(item.conf=='mid'?'可能是':'没找到')}}{{item.target ? '：' + item.target.party + (item.target.item ? ' ' + item.target.item : '') + '（还欠 ¥' + item.target.left + '）' : ''}}</text>
          <text class="aline-note" wx:if="{{item.why}}">{{item.why}}</text>
          <view class="btns" wx:if="{{!item.done && item.target}}">
            <button size="mini" bindtap="confirmBankAuto" data-i="{{index}}">就用这个</button>
            <button size="mini" wx:for="{{item.alts}}" wx:for-item="alt" wx:for-index="ai" wx:key="id" bindtap="pickBankAlt" data-i="{{index}}" data-a="{{ai}}">{{alt.party}} ¥{{alt.left}}</button>
          </view>
          <text class="aline-note" wx:if="{{item.done}}">✓ 已自动认领</text>
        </view>
        <view class="frow" wx:if="{{ba.high>0}}">
          <button class="btn" size="mini" bindtap="applyBankAuto">全部自动认领（{{ba.high}} 笔）</button>
        </view>
      </view>
    </view>
    <view class="list" wx:if="{{bank_rows.length}}">
      <view class="item" wx:for="{{bank_rows}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.direction=='in' ? '收' : '付'}} · {{item.memo}}</text><text class="amt {{item.direction=='in' ? 'ok' : 'out'}}">¥{{item.amount}}</text></view>
        <view class="row2">{{item.date}}</view>
        <view class="btns">
          <button size="mini" wx:if="{{item.direction=='in'}}" bindtap="matchBankOrder" data-id="{{item.id}}">抵应收</button>
          <button size="mini" wx:if="{{item.direction=='out'}}" bindtap="matchBankPayable" data-id="{{item.id}}">抵应付</button>
          <button size="mini" bindtap="matchBankExpense" data-id="{{item.id}}">记成一笔账</button>
          <button size="mini" bindtap="delBankFlow" data-id="{{item.id}}">删</button>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">坏账核销记录（本月要不回来的 {{wf_bad}} 元 · 供应商免掉的 {{wf_waived}} 元）</view>
