                <text class="prev-n {{item.status==='accepted'||item.status==='ordered'?'ok':(item.status==='rejected'||item.status==='expired'?'red':'')}}">{{item.status_text}}{{item.status==='sent' ? '（还有 ' + item.days_left + ' 天）' : ''}}{{item.decided_at ? ' · ' + item.decided_at : ''}}</text>
              </view>
              <view class="qbtn">
                <text wx:if="{{item.status==='draft'}}" class="lnk" catchtap="sendQuote" data-id="{{item.id}}">发出去</text>
                <text wx:if="{{item.status==='sent'||item.status==='accepted'}}" class="lnk" catchtap="quoteToOrder" data-id="{{item.id}}">转成单子</text>
