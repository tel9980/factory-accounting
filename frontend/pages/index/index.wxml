          <view class="row2">{{item.cnt}} 单 · 欠款合计 ¥{{item.unpaid}} · 最久 {{item.oldest_days}} 天{{item.overdue>0?' · 已逾期'+item.overdue+'单':''}}{{item.due_soon>0?' · 7天内到期'+item.due_soon+'单':''}}</view>
