        </picker>
        <text class="dateClr" wx:if="{{o_date}}" data-f="o_date" bindtap="clearDate">今天</text>
      </view>
      <button class="btn" size="mini" bindtap="addOrder">记一笔应收</button>
      <view class="chips" wx:if="{{contacts_ar.length}}">
        <text class="chip-label">常用客户：</text>
        <text class="chip" wx:for="{{contacts_ar}}" wx:key="name" wx:if="{{index < 8}}" bindtap="pickCustomer" data-n="{{item.name}}">{{item.name}}</text>
      </view>
    </view>
    <view class="form">
      <view class="tip">客户先给钱、活还没做 → 记预收款，开单后可一键抵扣</view>
      <input class="inp" placeholder="客户名" value="{{a_party}}" bindinput="onAParty"/>
      <input class="inp" placeholder="预收金额(元)" type="digit" value="{{a_amount}}" bindinput="onAAmount"/>
      <input class="inp" placeholder="备注(可选)" value="{{a_remark}}" bindinput="onARemark"/>
      <button class="btn" size="mini" bindtap="addAdvance">记一笔预收款</button>
      <view class="chips" wx:if="{{adv_in.length}}">
        <text class="chip-label">手上的预收：</text>
        <text class="chip" wx:for="{{adv_in}}" wx:key="id" bindtap="delAdvance" data-id="{{item.id}}" bindlongpress="delAdvance">{{item.party}} ¥{{item.remain}}（长按删）</text>
      </view>
    </view>
    <view class="form">
      <view class="tip">客户一次打款，自动抵多张单（先老后新）</view>
      <input class="inp" placeholder="客户名" value="{{rb_customer}}" bindinput="onRbCustomer"/>
      <input class="inp" placeholder="收到金额(元)" type="digit" value="{{rb_amount}}" bindinput="onRbAmount"/>
      <input class="inp" placeholder="收款日期(可选，如07-05)" value="{{rb_date}}" bindinput="onRbDate"/>
      <button class="btn" size="mini" bindtap="receiveBatch">批量核销收款</button>
      <button class="btn gray" size="mini" bindtap="dunning">生成催款清单</button>
      <view class="chips" wx:if="{{contacts_ar.length}}">
        <text class="chip-label">点客户名填入：</text>
        <text class="chip" wx:for="{{contacts_ar}}" wx:key="name" wx:if="{{index < 8}}" bindtap="pickRbCustomer" data-n="{{item.name}}">{{item.name}}</text>
      </view>
    </view>
    <view class="sumstrip">
      <view class="su"><view class="sun">{{ar_sum.open_amount || 0}}</view><view class="sul">未收合计 {{ar_sum.open_count || 0}} 单</view></view>
      <view class="su"><view class="sun red">{{ar_sum.overdue_amount || 0}}</view><view class="sul">逾期30天+ {{ar_sum.overdue_count || 0}} 单</view></view>
      <view class="su"><view class="sun org">{{ar_sum.due_amount || 0}}</view><view class="sul">7天内到期 {{ar_sum.due_count || 0}} 单</view></view>
      <view class="su"><view class="sun green">{{ar_sum.month_settled || 0}}</view><view class="sul">本月已收 · 新单 {{ar_sum.month_new || 0}}</view></view>
    </view>
    <view class="form">
      <input class="inp" placeholder="搜索客户/产品" value="{{ar_kw}}" bindinput="onArKw"/>
      <view class="chips">
        <text class="chip {{ar_filter==item.k?'on':''}}" wx:for="{{ar_filters}}" wx:key="k" bindtap="pickArFilter" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">排序：</text>
        <text class="chip {{ar_sort==item.k?'on':''}}" wx:for="{{ar_sorts}}" wx:key="k" bindtap="pickArSort" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">视图：</text>
        <text class="chip {{ar_view=='order'?'on':''}}" bindtap="pickArView" data-v="order">按单据</text>
        <text class="chip {{ar_view=='party'?'on':''}}" bindtap="pickArView" data-v="party">按客户</text>
      </view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="openCollect" data-type="ar">📣 催款清单（谁欠得久先催谁）</button>
      </view>
      <view class="prev" wx:if="{{collect}}">
        <view class="prev-h">【{{collect.type_text}}清单】{{collect.count}} 家 · 合计 {{collect.total}} 元（按「欠得久 × 欠得多」排）</view>
        <view class="prev-row" wx:for="{{collect.list}}" wx:key="party" data-i="{{index}}" bindtap="copyCollectOne">
          <text class="prev-t">{{item.no}}. {{item.party}}</text>
          <text class="prev-n">欠 {{item.left}} · {{item.why}}</text>
          <text class="prev-n {{item.told_days!==null && item.told_days<=3 ? 'red':''}}">{{item.told_text}}</text>
          <text class="red" catchtap="recordDunning" data-party="{{item.party}}" data-type="{{collect.type}}">记一笔催款</text>
        </view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyCollectAll">📋 全部复制</button>
          <button class="btn ghost" size="mini" bindtap="makeCollectImage">🖼 存成图片发微信</button>
          <button class="btn ghost" size="mini" bindtap="openDunLog" data-type="{{collect.type}}">📋 催款台账</button>
          <button class="btn ghost" size="mini" bindtap="closeCollect">收起</button>
        </view>
        <view class="prev" wx:if="{{dun_log}}">
          <view class="prev-h">催款台账{{dun_log.type=='ap' ? '（应付）' : '（应收）'}}　共 {{dun_log.count}} 条　本月 {{dun_log.month_count}} 条{{dun_log.broken_count>0 ? '　失约 ' + dun_log.broken_count + ' 次' : ''}}</view>
          <view class="prev-row" wx:for="{{dun_log.rows}}" wx:key="id">
            <text class="prev-t">{{item.date}} · {{item.party}}</text>
            <text class="prev-n">{{item.note || '已催'}}{{item.promise_date ? '　答应 ' + item.promise_date + ' 付' : ''}}{{item.pstate_text ? '（' + item.pstate_text + '）' : ''}}</text>
            <text class="red" catchtap="delDunLog" data-id="{{item.id}}">删</text>
          </view>
          <view class="frow"><button class="btn ghost" size="mini" bindtap="closeDunLog">收起台账</button></view>
          <view class="tip">催完一家马上记一笔，系统记得「催过几次、上次哪天、答应哪天付」；答应的日子过了还没付，首页会单独提醒。</view>
        </view>
        <view class="tip">点某一家 = 只复制那家的话；「存成图片」= 生成一张提醒卡，微信里可以直接转发给对方。</view>
      </view>

      <view class="frow">
        <button class="btn ghost" size="mini" bindtap="openDue" data-type="ar">📅 到期表</button>
        <button class="btn ghost" size="mini" bindtap="openRisk" data-type="ar">⚠️ 超期分级</button>
      </view>

      <view class="prev" wx:if="{{due && due.type=='ar'}}">
        <view class="prev-h">到期表　未结 {{due.count}} 张 · 合计 {{due.total}} 元</view>
        <view class="prev-row red"><text class="prev-t">已逾期 {{due.overdue_total}} 元</text><text class="prev-n">7 天内到期 {{due.soon_total}} 元</text><text>没到期日 {{due.no_due_total}} 元</text></view>
        <view class="prev-row" wx:for="{{due.rows}}" wx:key="id">
          <text class="prev-t">{{item.party}}  {{item.left}}</text>
          <text class="prev-n">{{item.due || '没到期日'}}{{item.guess ? '(按账期)' : ''}}</text>
          <text class="{{item.days>0?'red':'ok'}}">{{item.state}}</text>
        </view>
        <view class="tip" wx:if="{{due.more}}">后面还有 {{due.more}} 张，导出 Excel 能看全。</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="downloadDueXlsx">⬇ 导出 Excel（发客户对账）</button>
          <button class="btn ghost" size="mini" bindtap="closeDue">收起</button>
        </view>
      </view>

      <view class="prev" wx:if="{{risk && risk.type=='ar'}}">
        <view class="prev-h">超期分级　{{risk.level}}</view>
        <view class="prev-row" wx:for="{{risk.b}}" wx:key="label">
          <text class="prev-t">{{item.label}}</text>
          <text class="prev-n">{{item.cnt}} 笔</text>
          <text class="{{item.label.indexOf('90')>=0?'red':'ok'}}">{{item.amount}} 元</text>
        </view>
        <view class="prev-row red" wx:if="{{risk.bad_count}}">拖最久的 {{risk.bad_count}} 家：{{risk.bad[0].party}} {{risk.bad[0].left}} 元（{{risk.bad[0].worst}} 天）</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyRiskText">📋 复制这份分级</button>
          <button class="btn ghost" size="mini" bindtap="closeRisk">收起</button>
        </view>
        <view class="tip">超过 90 天的那一档单独列出来——这就是该考虑催到底、还是核销坏账的小名单。</view>
      </view>
    </view>
    <view class="list" wx:if="{{ar_view=='party'}}">
      <view class="grp" wx:for="{{ar_groups}}" wx:key="name">
        <view class="grp-h" bindtap="toggleGroupAr" data-n="{{item.name}}">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{ar_open==item.name?'收起':'欠'+item.unpaid}}</text></view>
          <view class="row2">{{item.cnt}} 单 · 欠款合计 {{item.unpaid}} · 最久 {{item.oldest_days}} 天{{item.overdue>0?' · 逾期'+item.overdue+'单':''}}{{item.due_soon>0?' · 7天内到期'+item.due_soon+'单':''}}</view>
        </view>
        <view class="grp-b" wx:if="{{ar_open==item.name}}">
          <view class="gitem" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="row1"><text class="nm">{{it.title}}</text><text class="amt">欠{{it.unpaid}}</text></view>
            <view class="row2">总{{it.total}} · 已收{{it.paid}}{{it.written_off>0?' · 核销'+it.written_off:''}} · 已欠{{it.days}}天{{it.due_short?' · 约定'+it.due_short:''}}{{it.operator?' · '+it.operator:''}}</view>
            <view class="btns">
              <button size="mini" bindtap="receiveAll" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">收清</button>
              <button size="mini" bindtap="payOrder" data-id="{{it.id}}">收款</button>
              <button size="mini" bindtap="showDetail" data-id="{{it.id}}" data-type="ar">明细</button>
              <button size="mini" bindtap="openReceipt" data-id="{{it.id}}" data-type="ar">收据</button>
              <button size="mini" bindtap="editDue" data-id="{{it.id}}" data-type="ar" data-due="{{it.due_short}}">改期</button>
              <button size="mini" bindtap="writeoffOrder" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">核销</button>
            </view>
          </view>
          <view class="tip" wx:if="{{item.items_more}}">列表最多 100 笔（先早后晚），要全的可以看对账单</view>
          <view class="row2" wx:if="{{!item.items.length}}">正在取这家单据…</view>
          <view class="btns">
            <button size="mini" bindtap="groupReceive" data-n="{{item.name}}" data-amt="{{item.unpaid}}">整户收款</button>
            <button size="mini" bindtap="statement" data-type="ar" data-name="{{item.name}}">对账单</button>
            <button size="mini" bindtap="monthStatement" data-type="ar" data-name="{{item.name}}">月结</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!ar_groups.length}}">按{{ar_filter=='overdue'?'逾期':'未结'}}没有客户欠款</view>
    </view>
    <view class="list" wx:if="{{ar_view=='order'}}">
      <view class="item" wx:for="{{ar_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.customer}} · {{item.item_name}}</text><text class="amt">欠{{item.unpaid}}</text></view>
        <view class="row2">总{{item.price}} · 已收{{item.paid}}{{item.written_off>0?' · 核销'+item.written_off:''}} · 已欠{{item.days}}天{{item.due_short?' · 约定'+item.due_short:''}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="row2" wx:if="{{item.cost>0}}">成本 {{item.cost}} · 毛利 {{item.gross}}（{{item.gross_pct}}%）</view>
        <view class="row2">{{item.status==2?'已交付':item.status==1?'加工中':'待加工'}}{{item.progress?' · 工序:'+item.progress:''}}{{item.settled?' · 已结清':''}}</view>
        <view class="btns">
          <button size="mini" bindtap="receiveAll" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}" wx:if="{{!item.settled}}">收清</button>
          <button size="mini" bindtap="showDetail" data-id="{{item.id}}" data-type="ar">明细</button>
          <button size="mini" bindtap="openReceipt" data-id="{{item.id}}" data-type="ar">收据</button>
          <button size="mini" bindtap="editDue" data-id="{{item.id}}" data-type="ar" data-due="{{item.due_short}}">改期</button>
          <button size="mini" bindtap="payOrder" data-id="{{item.id}}">收款</button>
          <button size="mini" bindtap="finishOrder" data-id="{{item.id}}">交付</button>
          <button size="mini" bindtap="editProgress" data-id="{{item.id}}">进度</button>
          <button size="mini" bindtap="applyAdvanceOrder" data-id="{{item.id}}">预收抵</button>
          <button size="mini" bindtap="writeoffOrder" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}">核销</button>
          <button size="mini" bindtap="againOrder" data-id="{{item.id}}">再来一单</button>
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="editOrder" data-id="{{item.id}}">改</button>
          <button size="mini" wx:if="{{role=='staff'}}" bindtap="openEditReq" data-kind="ar" data-id="{{item.id}}">申请改</button>
          <button size="mini" bindtap="statement" data-type="ar" data-name="{{item.customer}}">对账</button>
          <button size="mini" bindtap="monthStatement" data-type="ar" data-name="{{item.customer}}">月结</button>
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="delOrder" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!ar_list.length}}">{{ar_filter=='closed'?'没有已结清的应收':'没有未结清的应收'}}</view>
      <view class="loadmore" wx:if="{{ar_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ar_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

