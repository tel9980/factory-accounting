        <view class="item" wx:for="{{budgets}}" wx:key="id">
          <view class="row1">{{item.category}} · 每月 ¥{{item.amount}}</view>
          <view class="row2">设于 {{item.created_at}}<button size="mini" bindtap="delBudget" data-id="{{item.id}}">删</button></view>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">📦 月度结转归档（把该月账目定版：出报表、打快照、锁定不许改）</view>
      <input class="inp" placeholder="月份，如 {{this_month}}" value="{{lock_month}}" bindinput="onLockMonth"/>
      <view class="frow">
        <button class="btn" size="mini" bindtap="loadMonthEnd">🗓 月底收尾（一屏看完）</button>
        <button class="btn" size="mini" bindtap="closeMonth">结转归档（出报表 + 锁定）</button>
      </view>
      <view wx:if="{{me}}">
        <view class="prev-h">{{me.month}} · {{me.total}} 件事办了 {{me.done_count}}/{{me.total}}</view>
        <view class="tip" wx:if="{{me.locked}}">🔒 这个月已经结账锁定了，不能再增删改；要改就在下面归档区点「解锁」，改完重新结一次。</view>
        <view class="aline {{me.ready?'ok':'warn'}}">{{me.advice}}</view>
        <view class="tip">本月：接单 {{me.numbers.income}} · 材料·外协 {{me.numbers.mat}} · 现金费用+摊销折旧 {{me.numbers.cost_other}} · 净利 {{me.numbers.profit}}（净利率 {{me.numbers.margin}}%）· 手头现金 {{me.numbers.cash}}</view>
        <view class="hk-row" wx:for="{{me.steps}}" wx:key="k" bindtap="meGo" data-tab="{{item.tab}}">
          <view class="hk-main">
            <view class="hk-t {{item.done?'ok':''}}">{{item.done?'✓':'○'}} {{item.no}}. {{item.title}}</view>
            <view class="hk-d">{{item.detail}}{{item.done?'':' · ' + item.tip}}</view>
          </view>
          <text class="hk-a">{{item.done?'':'去办 ›'}}</text>
        </view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="meClose" wx:if="{{!me.locked}}">🧾 结账 {{me.month}}</button>
          <button class="btn ghost" size="mini" bindtap="closeMonthEnd">收起</button>
        </view>
      </view>
      <button class="btn" size="mini" bindtap="printReport">🖨 打印报表（A4，资产负债表 / 利润表）</button>
      <view class="list" wx:if="{{archives.length}}">
        <view class="item" wx:for="{{archives}}" wx:key="month">
          <view class="row1"><text class="nm">{{item.month}} 已归档</text><text class="amt">净利 {{item.profit}}</text></view>
          <view class="row2">接单 {{item.order_add}} · 材料成本 {{item.mat_cost}} · 现金费用+摊销折旧 {{item.cost}} · 净利率 {{item.margin}}% · 净资产 {{item.net_worth}}</view>
          <view class="row2">归档于 {{item.created_at}}</view>
          <view class="btns">
            <button size="mini" bindtap="viewArchive" data-m="{{item.month}}">看快照</button>
            <button size="mini" bindtap="printReport" data-m="{{item.month}}">打印</button>
            <button size="mini" bindtap="delArchive" data-m="{{item.month}}">🔓 解锁（删归档）</button>
          </view>
        </view>
      </view>
      <view class="tip" wx:if="{{month_locks.length}}">已锁定月份：{{month_locks.length}} 个（归档会自动锁定）</view>
    </view>
    <view class="form">
      <view class="tip">回收站（删掉的账先放这里，30 天内可恢复）</view>
      <view class="list" wx:if="{{trash_list.length}}">
        <view class="item" wx:for="{{trash_list}}" wx:key="batch">
          <view class="row1">{{item.items.length}} 条 · 删除于 {{item.deleted_at}}</view>
          <view class="row2 pre">{{item.items}}</view>
          <view class="btns">
            <button size="mini" bindtap="restoreTrash" data-id="{{item.ids[0]}}">恢复</button>
            <button size="mini" bindtap="purgeTrash" data-id="{{item.ids[0]}}">彻底删除</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!trash_list.length}}">回收站是空的</view>
    </view>
    <view class="form">
      <view class="tip">操作日志（最近 100 条，防有人乱改账）</view>
      <view class="list" wx:if="{{audit_logs.length}}">
        <view class="item" wx:for="{{audit_logs}}" wx:key="id">
          <view class="row1">{{item.action}}{{item.target ? ' · ' + item.target : ''}}</view>
          <view class="row2">{{item.detail}} · {{item.created_at}}</view>
        </view>
      </view>
      <view class="tip" wx:else>暂无操作记录</view>
    </view>
    <view class="tip" wx:if="{{cloud_backup_at}}">最近云端备份：{{cloud_backup_at}}（每天自动备份一次）</view>
    <view class="list" wx:if="{{report_text}}">
      <view class="item">
        <view class="row2 pre">{{report_text}}</view>
        <view class="btns">
          <button size="mini" bindtap="copyReport">复制报表</button>
          <button size="mini" bindtap="genReportImage">生成图片</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab=='asset'}}">
    <view class="cards" wx:if="{{nw_latest}}">
      <view class="card">
        <view class="num">{{nw_latest.net}}</view>
        <view class="label">家底（现金+别人欠我−我欠别人−借款）</view>
      </view>
      <view class="card">
        <view class="num">{{nw_latest.cash}}</view>
        <view class="label">手里现金</view>
      </view>
    </view>
    <view class="biz" wx:if="{{nw_latest}}">
      <text>别人欠我</text><text class="amt">{{nw_latest.ar}}</text>
    </view>
    <view class="biz" wx:if="{{nw_latest}}">
      <text>我欠别人</text><text class="amt out">{{nw_latest.ap}}</text>
    </view>

    <view class="form">
      <view class="tip">🏦 借款台账（银行 / 亲友）{{debt_sum.count ? '：共 ' + debt_sum.count + ' 笔，还欠 ' + debt_sum.total_principal + ' 元，每月利息约 ' + debt_sum.month_interest + ' 元' : ''}}</view>
      <view class="debt-add" wx:if="{{role!='staff'}}">
        <input class="inp" placeholder="出借方（如 XX 银行 / 张三）" value="{{d_lender}}" bindinput="onDLender"/>
        <view class="frow">
          <picker range="{{debt_kinds}}" value="{{d_kind}}" bindchange="onDKind"><view class="picker">类型：{{debt_kinds[d_kind]}} ▾</view></picker>
          <input class="inp half" placeholder="本金" type="digit" value="{{d_principal}}" bindinput="onDPrincipal"/>
        </view>
        <view class="frow">
          <input class="inp half" placeholder="年利率 %" type="digit" value="{{d_rate}}" bindinput="onDRate"/>
          <input class="inp half" placeholder="几期(月)" type="number" value="{{d_term}}" bindinput="onDTerm"/>
        </view>
        <view class="frow">
          <picker range="{{debt_paykinds}}" value="{{d_paykind}}" bindchange="onDPayKind"><view class="picker">还款方式：{{debt_paykinds[d_paykind]}} ▾</view></picker>
        </view>
        <view class="frow">
          <picker mode="date" value="{{d_start}}" bindchange="onDStart"><view class="picker">起借日：{{d_start || '今天'}} ▾</view></picker>
        </view>
        <input class="inp" placeholder="备注（可不填）" value="{{d_remark}}" bindinput="onDRemark"/>
        <button class="btn" size="mini" bindtap="addDebt">记一笔借款（钱进账户）</button>
        <button class="btn" size="mini" bindtap="runAccrual">补提本月利息（自动记成本）</button>
      </view>
      <view class="list" wx:if="{{debts.length}}">
        <view class="item" wx:for="{{debts}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.lender}}</text><text class="amt out">还欠 {{item.remain}}</text></view>
          <view class="row2">{{item.kind_name}} · 年息 {{item.rate}}% · 月息 {{item.monthly_interest}} 元 · {{item.pay_kind_name}}</view>
          <view class="row2" wx:if="{{item.status=='open'}}">下次还款 {{item.next_due}} 约 {{item.next_amount}} 元<text class="red" wx:if="{{item.overdue}}"> · 已逾期，快处理</text></view>
          <view class="row2" wx:else>已还清</view>
          <view class="btns">
            <button size="mini" wx:if="{{item.status=='open'}}" bindtap="repayDebt" data-id="{{item.id}}">还款</button>
            <button size="mini" bindtap="repayDebt" data-id="{{item.id}}">计划</button>
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="delDebt" data-id="{{item.id}}">删</button>
          </view>
        </view>
      </view>
      <view class="tip" wx:else>还没有借款记录。有银行贷款或亲友借款就记一笔，每月利息会自动算，到期前提醒你。</view>
    </view>

    <view class="form">
      <view class="tip">🗓 待摊费用（房租/保险一次付几个月，按月摊进成本）{{prepaid_sum.open_count ? '：' + prepaid_sum.open_count + ' 项在摊，每月约 ' + prepaid_sum.month_amount + ' 元，还没摊完 ' + prepaid_sum.total_left + ' 元' : ''}}</view>
      <view class="debt-add" wx:if="{{role!='staff'}}">
        <input class="inp" placeholder="名称（如 一年厂房房租）" value="{{pp_name}}" bindinput="onPPName"/>
        <view class="frow">
          <input class="inp half" placeholder="一共付了多少" type="digit" value="{{pp_total}}" bindinput="onPPTotal"/>
          <input class="inp half" placeholder="摊几个月" type="number" value="{{pp_months}}" bindinput="onPPMonths"/>
        </view>
        <view class="frow">
          <input class="inp half" placeholder="分类（房租/保险…）" value="{{pp_cat}}" bindinput="onPPCat"/>
          <picker mode="date" value="{{pp_start}}" bindchange="onPPStart"><view class="picker">付款日：{{pp_start || '今天'}} ▾</view></picker>
        </view>
        <button class="btn" size="mini" bindtap="addPrepaid">记待摊（钱先付出去，成本按月摊）</button>
        <button class="btn" size="mini" bindtap="runAmort">补摊本月（有漏掉的月份就点这里）</button>
      </view>
      <view class="list" wx:if="{{prepaids.length}}">
        <view class="item" wx:for="{{prepaids}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{item.active=='open' ? '还没摊 ' + item.remain : '已摊完'}}</text></view>
          <view class="row2">总额 {{item.total}} · 每月 {{item.per_month}} · 已摊 {{item.amortized}}（{{item.done_months}}/{{item.months}} 个月）</view>
          <view class="row2" wx:if="{{item.next_month}}">下次摊销 {{item.next_month}} 约 {{item.per_month}} 元</view>
          <view class="btns">
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="togglePrepaid" data-id="{{item.id}}" data-active="{{item.active}}">{{item.active=='open' ? '停摊' : '继续摊'}}</button>
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="delPrepaid" data-id="{{item.id}}">删</button>
          </view>
        </view>
      </view>
      <view class="tip" wx:else>还没有待摊费用。比如一次交了 1 年房租 1.2 万，记成 12 个月摊：钱当天出账，成本每月只算 1000，利润不会某个月特别难看。</view>
    </view>

    <view class="chart" wx:if="{{nw.length}}">
      <view class="chart-title">近 12 个月家底变化（数字=净资产）</view>
      <view class="bar-line" wx:for="{{nw}}" wx:key="m">
        <view class="bar-m">{{item.m}}</view>
        <view class="bar-zone">
          <view class="bar bar-in" style="width:{{item.w}}%"></view>
          <text class="bar-num">{{item.net}}</text>
        </view>
      </view>
    </view>

    <view class="form" wx:if="{{nws}}">
      <view class="tip">📌 家底存档（每月最后一天自动存一份；改了老单据也不会带偏已存的数）</view>
      <view class="aline" wx:for="{{nws.advice}}" wx:key="*this">{{item}}</view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="saveNetworthSnap">{{nws.has_this_month?'重存这个月':'记下这个月的家底'}}</button>
      </view>
      <view class="tip" wx:if="{{nws.current}}">现在算出来：现金 {{nws.current.cash}}、别人欠我 {{nws.current.ar}}、我欠别人 {{nws.current.ap}}、借款 {{nws.current.debt}} → 净资产 {{nws.current.net}} 元</view>
      <view class="item" wx:for="{{nws.rows}}" wx:key="month">
        <view class="row1">
          <text class="nm">{{item.month}} 净资产 ¥{{item.net}}</text>
          <text class="amt" wx:if="{{item.delta!==null}}">{{item.delta>=0?'比上月 +':'比上月 '}}{{item.delta}}</text>
        </view>
        <view class="row2">现金 {{item.cash}} · 应收 {{item.ar}} · 应付 {{item.ap}} · 借款 {{item.debt}}</view>
        <view class="row2" wx:if="{{item.drift}}">⚠ 现在重新算是 {{item.live_net}}（差 {{item.drift}}，说明这月的单据后来改过）</view>
        <view class="row2" wx:if="{{item.note}}">{{item.note}}</view>
        <button class="btn ghost" size="mini" wx:if="{{role!='staff'}}" bindtap="delNetworthSnap" data-m="{{item.month}}">删</button>
      </view>
      <view class="tip" wx:if="{{!nws.rows.length}}">还没有存档。到月底会自动存；想现在留个底就点上面的按钮。</view>
    </view>

    <view class="form" wx:if="{{kpi}}">
      <view class="tip">财务指标（{{kpi.month}}）</view>
      <view class="kpi-row"><text>本月净利率</text><text class="kpi-n {{kpi.margin>=0?'ok':'bad'}}">{{kpi.margin}}%（净利 {{kpi.profit}}）</text></view>
      <view class="kpi-row"><text>平均回款天数</text><text class="kpi-n">{{kpi.avg_days}} 天</text></view>
      <view class="kpi-row"><text>应收周转天数</text><text class="kpi-n">{{kpi.turn_days}} 天</text></view>
      <view class="kpi-row"><text>现金能撑几个月</text><text class="kpi-n {{kpi.cushion_months>=1?'ok':'bad'}}">{{kpi.cushion_months}} 个月</text></view>
      <view class="kpi-row" wx:if="{{kpi.top_customer}}"><text>最大客户占比</text><text class="kpi-n {{kpi.conc_pct>=60?'bad':''}}">{{kpi.top_customer}} {{kpi.conc_pct}}%</text></view>
      <view class="kpi-row"><text>本月成本合计</text><text class="kpi-n">{{kpi.cost_total}}（材料 {{kpi.mat_cost}} + 现金费用 {{kpi.cash_cost}} + 摊销 {{kpi.amort}} + 折旧 {{kpi.dep}} + 预提息 {{kpi.accrue_int}}）</text></view>
      <view class="kpi-row"><text>费用率（成本/接单）</text><text class="kpi-n {{kpi.expense_ratio>=100?'bad':''}}">{{kpi.expense_ratio}}%</text></view>
      <view class="kpi-row" wx:if="{{kpi.break_even>0}}"><text>保本月收入</text><text class="kpi-n">约 {{kpi.break_even}} 元（低于这个数就亏）</text></view>
      <view class="kpi-row"><text>净资产</text><text class="kpi-n {{kpi.net_worth<0?'bad':'ok'}}">{{kpi.net_worth}} 元</text></view>
      <view class="kpi-sub">近 6 个月净利趋势</view>
      <view class="bar-line" wx:for="{{kpi.trend}}" wx:key="m">
        <view class="bar-m">{{item.m}}</view>
        <view class="bar-zone">
          <view class="bar bar-in" style="width:{{item.margin>0?item.margin:0}}%"></view>
          <text class="bar-num">{{item.profit}}（{{item.margin}}%）</text>
        </view>
      </view>
      <view class="tip">净利率 =（本月接单 − 材料·外协成本 − 现金费用 − 摊销 − 折旧 − 预提息）/ 接单。赊购只算欠款、不重复算成本。现金能撑几个月 = 手头现金 / 近 3 月平均月支出。</view>
    </view>

    <view class="form">
      <view class="tip">💰 毛利分析（按单里填的「材料·外协成本」算真实毛利）</view>
      <view class="btns">
        <view class="seg {{mb_type=='customer'?'on':''}}" bindtap="setMbType" data-t="customer">按客户</view>
        <view class="seg {{mb_type=='product'?'on':''}}" bindtap="setMbType" data-t="product">按产品</view>
      </view>
      <view class="frow">
        <input class="inp half" placeholder="月份，如 2026-11（留空=全部）" value="{{mb_month}}" bindinput="onMbMonth" bindconfirm="loadMarginBy"/>
        <button class="btn half" size="mini" bindtap="loadMarginBy">查一下</button>
      </view>
      <view wx:if="{{mb}}">
        <view class="kpi-row"><text>合计收入</text><text class="kpi-n">{{mb.revenue}} 元（{{mb.count}} 单）</text></view>
        <view class="kpi-row"><text>材料·外协成本</text><text class="kpi-n">{{mb.cost}} 元</text></view>
        <view class="kpi-row"><text>毛利</text><text class="kpi-n {{mb.profit>=0?'ok':'bad'}}">{{mb.profit}} 元 · 毛利率 {{mb.margin_pct}}%</text></view>
        <view class="duesoon" wx:if="{{mb.missing_cost>0}}">{{mb.hint}}</view>
        <view class="list">
          <view class="item" wx:for="{{mb.list}}" wx:key="name">
            <view class="row1"><text class="nm">{{item.name}}</text><text class="amt {{item.profit<0?'red':''}}">{{item.profit}}</text></view>
            <view class="row2">{{item.cnt}} 单 · 收入 {{item.revenue}} · 成本 {{item.cost}} · 毛利率 {{item.margin_pct}}%<text wx:if="{{item.no_cost>0}}"> · {{item.no_cost}} 单没填成本</text></view>
            <view class="row2" wx:if="{{item.unpaid>0}}">还没收 {{item.unpaid}} 元</view>
          </view>
        </view>
        <view class="tip" wx:if="{{mb.worst.length}}">最不赚钱：{{mb.worst[0].name}}（毛利 {{mb.worst[0].profit}}，毛利率 {{mb.worst[0].margin_pct}}%）</view>
