<view class="page {{big?'big':''}}">
<!-- 术语口径：应收/应付只说「未结清」和「已逾期」；成本统一说「摊销」「设备摊销」「预提利息」。 -->
  <view class="bookbar" bindtap="setTab" data-t="contact">当前账套：{{book_name}}（点此切换 / 改名）</view>
  <view class="offbar demo" wx:if="{{demo}}" bindtap="exitDemo">👀 演示账套（示例数据，随便点都动不到你的账）· 点这里换成我自己的口令</view>
  <view class="offbar sup" wx:if="{{super}}">👑 超级管理员：哪一本账都能管 · 点这里换账套</view>
  <view class="offbar sup" wx:elif="{{book_admin}}">🔑 这本账的管理员（别的账套看不到）</view>
  <!-- F7：断网时要说清「这份数据是什么时候的」，不然用户会把旧金额当今天的 -->
  <view class="offbar" wx:if="{{offline_at}}" bindtap="refresh">📴 现在没网，看到的是 {{offline_at}} 存下来的数据（金额不是最新的）· 点这里重试</view>
  <view class="pendbar" wx:if="{{pending_count}}" bindtap="viewPending">📤 有 {{pending_count}} 笔没发出去（已存在手机上）· 点这里查看 / 重发</view>
  <view class="offbar" wx:if="{{net_bad}}" bindtap="retryAll">⚠️ 有些数据没拉出来（网不太好）· 点这里重试</view>
  <view class="offbar" wx:if="{{no_key && !key_open}}" bindtap="reopenKey">🔒 还没设口令，现在这页是空的（不是真没钱）· 点这里设（想先看看就走「先看看演示」，不用口令）</view>
  <view class="sealbar" wx:if="{{sealed}}" bindtap="goSeal">🔒 这本账已封存（只读），{{sealed_at}}起 · 点这里去解封</view>
  <!-- G8（分包）：本项目没有分包目录约定（app.json 里只有一个页面、没有 subpackages），
       所以不做分包改造，也不动构建体系。替代做法：所有大块列表都用 wx:if 懒渲染 ——
       数据没加载出来就不建 DOM，切到哪个页签才渲染哪块，避免主包一次性铺开。
       以后要真分包，优先把「报表」和「材料」两块搬进分包目录。 -->

  <view class="mask" wx:if="{{key_open}}" catchtap="closeKey">
    <view class="keycard" catchtap="noop">
      <view class="keytt">{{key_mode=='set'?'第一次用，设个口令':'输入访问口令'}}</view>
      <view class="tip" wx:if="{{key_mode=='set'}}">这是你自己定的记账口令（至少 4 位），不是微信密码。设好记牢，忘了可以用恢复码重设。</view>
      <view class="tip" wx:else>老板给你的那个口令。忘了就点下面的「用恢复码」。</view>
      <input class="inp" password placeholder="{{key_mode=='set'?'设置口令（至少 4 位）':'输入口令'}}" value="{{key_input}}" bindinput="onKeyInput"/>
      <!-- 第 11 轮 A1：自己用 Cloudflare 部署时，后端会生成一串「安装令牌」（写在部署日志摘要里）。
           第一次设口令必须带上它，否则谁先打开这个地址，谁就能把口令设成自己的。
           本机版 / 没配令牌的部署：这栏留空直接设就行。 -->
      <input class="inp" wx:if="{{key_mode=='set'}}" placeholder="安装令牌（没用 Cloudflare 部署就留空）" value="{{key_install}}" bindinput="onKeyInstall"/>
      <view class="keyerr" wx:if="{{key_err}}">{{key_err}}</view>
      <button class="btn" bindtap="submitKey">{{key_mode=='set'?'设好，开始记账':'进入'}}</button>
      <view class="keydemo" wx:if="{{demo_builtin!==false}}" bindtap="enterDemoLook">👀 先看看演示（不用口令，示例数据）</view>
      <!-- 审核要求：不许「必须先设口令才能看到任何东西」。所以「设口令」这一步旁边也要有演示入口，
           而且新装的库（还没设过口令）用演示口令也必须进得来（后端 no_key 守卫已放行 DEMO_KEY）。 -->
      <view class="keydemo" wx:if="{{key_mode=='set' && demo_builtin!==false}}">不用设口令也能先看：演示账套是示例数据，跟你的账不混</view>
      <view class="keyrecover" wx:if="{{key_mode!='set'}}" bindtap="keyRecover">忘了口令？用恢复码重设</view>
      <view class="keyclose" bindtap="closeKey">先不看</view>
    </view>
  </view>

  <view class="card" wx:if="{{er_open}}">
        <view class="ct">📝 申请改一下这张单</view>
        <view class="tip">{{er_title}}。改了要老板点「同意」才会生效。</view>
        <block wx:if="{{er_kind=='ar'}}">
          <input class="inp" placeholder="产品/工序" value="{{er_item}}" bindinput="onErItem"/>
          <input class="inp" type="digit" placeholder="金额" value="{{er_amount}}" bindinput="onErAmount"/>
          <input class="inp" type="digit" placeholder="成本（材料·外协，可不填）" value="{{er_cost}}" bindinput="onErCost"/>
        </block>
        <block wx:if="{{er_kind=='ap'}}">
          <input class="inp" type="digit" placeholder="应付金额" value="{{er_amount}}" bindinput="onErAmount"/>
        </block>
        <block wx:if="{{er_kind=='expense'}}">
          <input class="inp" type="digit" placeholder="金额" value="{{er_amount}}" bindinput="onErAmount"/>
          <input class="inp" placeholder="分类" value="{{er_cat}}" bindinput="onErCat"/>
        </block>
        <input class="inp" wx:if="{{er_kind!='expense'}}" placeholder="约定收/付款日（如 12-20，可不填）" value="{{er_due}}" bindinput="onErDue"/>
        <input class="inp" wx:if="{{er_kind=='ar'}}" placeholder="经手人" value="{{er_operator}}" bindinput="onErOperator"/>
        <input class="inp" wx:if="{{er_kind=='ap'}}" placeholder="备注" value="{{er_remark}}" bindinput="onErRemark"/>
        <input class="inp" wx:if="{{er_kind=='expense'}}" placeholder="备注" value="{{er_remark}}" bindinput="onErRemark"/>
        <input class="inp" placeholder="为什么改（如 单价记错了）" value="{{er_reason}}" bindinput="onErReason"/>
        <view class="btns">
          <button class="btn" size="mini" bindtap="submitEditReq">提交申请</button>
          <button class="btn ghost" size="mini" bindtap="closeEditReq">取消</button>
        </view>
      </view>
  <view class="mtabs">
    <view class="mtab {{group=='home'?'on':''}}" bindtap="setGroup" data-g="home">工作台</view>
    <view class="mtab {{group=='bill'?'on':''}}" bindtap="setGroup" data-g="bill">记账</view>
    <view class="mtab {{group=='stat'?'on':''}}" bindtap="setGroup" data-g="stat">报表</view>
    <view class="mtab {{group=='me'?'on':''}}" bindtap="setGroup" data-g="me">设置</view>
  </view>

  <view class="subtabs" wx:if="{{group=='bill'}}">
    <view class="sub {{tab=='ar'?'on':''}}" bindtap="setTab" data-t="ar">应收<text class="sbadge" wx:if="{{ar_sum.open_count}}">{{ar_sum.open_count}}</text></view>
    <view class="sub {{tab=='ap'?'on':''}}" bindtap="setTab" data-t="ap">应付<text class="sbadge" wx:if="{{ap_sum.open_count}}">{{ap_sum.open_count}}</text></view>
    <view class="sub {{tab=='expense'?'on':''}}" bindtap="setTab" data-t="expense">支出</view>
    <view class="sub {{tab=='import'?'on':''}}" bindtap="setTab" data-t="import">导入</view>
  </view>
  <view class="subtabs" wx:if="{{group=='stat'}}">
    <view class="sub {{tab=='report'?'on':''}}" bindtap="setTab" data-t="report">报表</view>
    <view class="sub {{tab=='asset'?'on':''}}" wx:if="{{role!='staff' && mod.asset!==false}}" bindtap="setTab" data-t="asset">家底</view>
    <view class="sub {{tab=='history'?'on':''}}" bindtap="setTab" data-t="history">历史</view>
    <view class="sub {{tab=='flows'?'on':''}}" bindtap="setTab" data-t="flows">流水</view>
  </view>
  <view class="subtabs" wx:if="{{group=='me'}}">
    <view class="sub on" bindtap="setTab" data-t="contact">单位 · 账户 · 设置</view>
  </view>

  <block wx:if="{{tab=='home'}}">
    <view class="qgrid3">
      <view class="qbtn3 blue" bindtap="quickGo" data-t="ar"><view class="qb-t">＋ 记一笔应收</view><view class="qb-d">客户又给活了</view></view>
      <view class="qbtn3 green" bindtap="goCollect"><view class="qb-t">💰 收钱</view><view class="qb-d">看谁还欠，点一下收清</view></view>
      <view class="qbtn3 orange" bindtap="quickGo" data-t="expense"><view class="qb-t">－ 记一笔支出</view><view class="qb-d">当场花的钱</view></view>
    </view>
    <view class="form">
      <input class="inp qinp" placeholder="一句话记账：张老板加工费5000（开单）" value="{{q_text}}" bindinput="onQText" bindconfirm="quick"/>
      <view class="qrow">
        <button class="btn" size="mini" bindtap="quick">记</button>
        <button class="btn btn-ghost" size="mini" bindtap="savePhrase">存为常用</button>
      </view>
      <view class="chips" wx:if="{{phrases.length}}">
        <view class="chip" wx:for="{{phrases}}" wx:key="id" bindtap="pickPhrase" data-t="{{item.text}}" bindlongpress="delPhrase" data-id="{{item.id}}">{{item.text}}</view>
      </view>
      <view class="tip">支持：张老板加工费5000（开一张应收单）· 付王五金货款3000 · 工资5000 · 水电300；也可点输入框用键盘语音说话</view>
      <view class="tip">⚠ 这里写「收…」是<text class="b">又开了一张单</text>，不是收到钱。收到钱请在下面列表里点开那张单，点「💰 收钱」。</view>
    </view>

    <view class="alertbar" wx:if="{{overdue_count > 0 || due_soon_count > 0 || pay_soon_count > 0}}" bindtap="jumpTodo">
      <view class="ab-t">今天要盯的款：{{due_brief}}</view>
      <view class="ab-a">去看 ›</view>
    </view>
    <view class="hstrip {{hc.score>=90?'good':hc.score>=75?'mid':'bad'}}" wx:if="{{hc}}" bindtap="openHealth">
      <view class="hs-l">
        <text class="hs-score">{{hc.score}}</text>
        <text class="hs-unit">分</text>
        <text class="hs-grade">{{hc.grade}}</text>
        <text class="hs-delta" wx:if="{{hc.delta>0}}">↑{{hc.delta}}</text>
        <text class="hs-delta down" wx:if="{{hc.delta<0}}">↓{{-hc.delta}}</text>
      </view>
      <view class="hs-r">{{hc.clean?'账本干干净净':hc.count+' 处可以改好'}} ›</view>
    </view>
    <view class="card ob" wx:if="{{onboard && onboard.show && !onboard.all_done}}">
      <view class="card-h">开账引导（照着填几步就能用）<text class="card-n">{{onboard.done}}/{{onboard.total}}</text></view>
      <view class="ob-tip">先把底数填上，欠款合计、毛利、手头现金才准。照着填完，一次就行。</view>
      <view class="ob-go" bindtap="openOnboardWizard">⚡ 一屏填完（推荐，30 秒）</view>
      <view class="ob-item {{item.done?'done':''}}" wx:for="{{onboard.steps}}" wx:key="k" bindtap="onbGo" data-k="{{item.k}}">
        <text class="ob-dot">{{item.done?'✓':'○'}}</text>
        <view class="ob-body">
          <view class="ob-t">{{item.t}}</view>
          <view class="ob-d">{{item.d}}</view>
        </view>
        <text class="ob-a">{{item.done?'已完成':'去填 ›'}}</text>
      </view>
      <view class="ob-x" catchtap="onbDismiss">不再提示</view>
    </view>
    <view class="card" wx:if="{{ob_open}}">
      <view class="card-h">开账向导<text class="card-n" bindtap="closeObWizard">关闭</text></view>
      <view class="tip">四块填完点最下面「保存，开始记账」。哪块没有就留空，不影响。</view>
      <view class="ob-sec">1. 现在手上有多少钱</view>
      <view class="ob-row" wx:for="{{ob_accs}}" wx:key="id">
        <text class="ob-k">{{item.name}}</text>
        <input class="ob-in" type="digit" placeholder="0" value="{{item.opening}}" bindinput="onObAcc" data-i="{{index}}" />
      </view>
      <view class="ob-sec">2. 默认账期（天）</view>
      <view class="ob-row">
        <text class="ob-k">新单到期日按这个算</text>
        <input class="ob-in" type="number" placeholder="30" value="{{ob_term}}" bindinput="onObTerm" />
      </view>
      <view class="ob-sec">3. 别人还欠我（一家一行：名字 空格 金额）</view>
      <textarea class="ob-ta" placeholder="张老板 12000&#10;李老板 8000" value="{{ob_ar}}" bindinput="onObAr" auto-height />
      <view class="ob-sec">4. 我还欠别人（一家一行：名字 空格 金额）</view>
      <textarea class="ob-ta" placeholder="某某化工 5000&#10;某某外协厂 8000" value="{{ob_ap}}" bindinput="onObAp" auto-height />
      <button class="btn" bindtap="applyOnboarding" loading="{{ob_busy}}">保存，开始记账</button>
    </view>
    <view class="card" wx:if="{{hc_open}}">
      <view class="card-h">账本健康<text class="card-n" bindtap="closeHealth">收起</text></view>
      <view class="tip">{{hc.clean?'目前没发现问题，继续保持：记完账点一下「明细」核对一眼，月底记得结账。':'下面这些都是「不影响现在记账、但会让数字不准」的地方，按顺序改掉就行。'}}</view>
      <block wx:for="{{hc.items}}" wx:key="k">
        <view class="hk-row" wx:if="{{item.count>0}}" bindtap="hpGo" data-tab="{{item.tab}}">
          <view class="hk-main">
            <view class="hk-t">{{item.label}}<text class="hk-n">{{item.count}}</text></view>
            <view class="hk-d">{{item.fix}}</view>
          </view>
          <text class="hk-a">去处理 ›</text>
        </view>
        <view class="hk-row" wx:else>
          <view class="hk-main"><view class="hk-t ok">✓ {{item.label}}</view></view>
        </view>
      </block>
    </view>
    <view class="card pipe" wx:if="{{pipe}}">
      <view class="card-h">本月财务流程<text class="card-n">{{pipe.done_count}}/{{pipe.total}}</text></view>
      <view class="goalbar"><view class="goalbar-in {{pipe.done_count>=pipe.total?'done':''}}" style="width:{{pipe.percent}}%"></view></view>
      <view class="pipe-row {{item.done?'done':''}} {{pipe.next_key==item.k?'now':''}}" wx:for="{{pipe.steps}}" wx:key="k" bindtap="pipeGo" data-tab="{{item.tab}}">
        <text class="pipe-dot">{{item.done?'✓':item.no}}</text>
        <view class="pipe-body">
          <view class="pipe-t">{{item.title}}</view>
          <view class="pipe-d">{{item.detail}}</view>
        </view>
        <text class="pipe-a">{{item.done?'':'去办 ›'}}</text>
      </view>
      <view class="tip">{{pipe.advice}}</view>
    </view>
    <view class="card" wx:if="{{rem_items.length}}">
      <view class="card-h">今天要做的事<text class="card-n">{{rem_items.length}}</text></view>
      <view wx:for="{{rem_items}}" wx:key="text" wx:for-item="ri">
        <view class="todo lv-{{ri.level}}" bindtap="goRem" data-tab="{{ri.tab}}">
          <text class="todo-dot"></text>
          <text class="todo-t">{{ri.text}}</text>
          <text class="todo-a">去处理 ›</text>
        </view>
        <view class="todo-list" wx:if="{{ri.list.length}}">
          <view class="todo-li" wx:for="{{ri.list}}" wx:for-item="li" wx:key="party">{{li.party}} ¥{{li.amount}} · {{li.note}}</view>
          <view class="todo-more" wx:if="{{ri.list.length >= 3}}">点上面这行进列表看全部 ›</view>
        </view>
      </view>
    </view>
    <view class="card" wx:if="{{!rem_items.length}}">
      <view class="card-h">今天要做的事</view>
      <view class="tip" wx:if="{{errs.rem}}">⚠️ 提醒没拉出来（不是没有）· <text class="lnk" bindtap="loadReminders">重试</text></view>
      <view class="tip" wx:else>没有到期欠款、没有超预算，账都是清的 👍</view>
    </view>

    <view class="grid4">
      <view class="g4" bindtap="setTab" data-t="ar">
        <view class="g4n">{{ar_total}}</view>
        <view class="g4l">客户欠我</view>
      </view>
      <view class="g4" bindtap="setTab" data-t="ap">
        <view class="g4n red">{{ap_total}}</view>
        <view class="g4l">我欠别人</view>
      </view>
      <view class="g4" bindtap="setTab" data-t="expense">
        <view class="g4n">{{today_income}}</view>
        <view class="g4l">今天收到</view>
      </view>
      <!-- catchtap 而不是 bindtap：以前点「本月净利」的 ⓘ 会先弹解释框、再冒泡到外面的
           setTab 把整页跳到报表页，看起来像点了两个东西。 -->
      <view class="g4" wx:if="{{role!='staff'}}" bindtap="setTab" data-t="report">
        <view class="g4n {{month_profit < 0 ? 'red' : 'green'}}" catchtap="explainProfit">{{month_profit}}</view>
        <view class="g4l" catchtap="explainProfit">本月赚的（收 − 付）ⓘ</view>
      </view>
    </view>
    <view class="aline bad" wx:if="{{dash_err}}" bindtap="loadDashboard">{{dash_err}}（点这里重试）</view>
    <view class="aline bad" wx:if="{{degraded}}" bindtap="loadDashboard">首页有 {{degraded}} 块没算出来（{{degraded_text}}），这几个数字可能偏小，点这里重试；一直这样就看「错误日志」</view>
    <view class="monthline">本月收 {{month_income}} · 付 {{month_outcome}}<text wx:if="{{role!='staff'}}">　|　单子算（含没收回来的）赚 {{profit_biz}}</text></view>
    <view class="monthline" wx:if="{{role!='staff' && (month_amort>0 || month_accrue_int>0)}}">成本已含：摊销 {{month_amort}}<text wx:if="{{month_dep>0}}"> · 设备摊销 {{month_dep}}</text><text wx:if="{{month_accrue_int>0}}"> · 预提利息 {{month_accrue_int}}</text>（本月成本合计 {{month_expense_cash}}）</view>
    <view class="card" wx:if="{{ns || (mw && mw.count>0)}}">
      <view class="card-h">今天的活<text class="card-n" wx:if="{{ns.rest>0}}" bindtap="toggleNextAll">{{ns_open ? '收起' : '还有 ' + ns.rest + ' 件 ›'}}</text></view>
      <view class="mwrow pri" wx:if="{{ns && ns.item}}" bindtap="goNext">
        <text class="mwdot blue">急</text>
        <view class="mwmain2">
          <text class="ns-t2">{{ns.item.title}}</text>
          <text class="ns-w2">{{ns.item.why}}</text>
        </view>
        <text class="mwside">去做 ›</text>
      </view>
      <view class="mwrow mtip" wx:if="{{mtip}}" bindtap="goMonthEnd">
        <text class="mwdot">月</text>
        <text class="mwmain">{{mtip.month}} 月底收尾还有 {{mtip.left}} 件没办（{{mtip.done}}/{{mtip.total}}）{{mtip.next ? '，下一步：' + mtip.next.title : ''}}</text>
        <text class="mwside">去办 ›</text>
      </view>
      <block wx:if="{{ns_open && ns.others.length}}">
        <view class="ns-alltip">按急慢排好了，点哪条就去哪页办</view>
        <view class="mwrow nso" wx:for="{{ns.others}}" wx:key="k" bindtap="goNextItem" data-i="{{index}}">
          <text class="mwdot blue">{{index + 2}}</text>
          <view class="mwmain2">
            <text class="ns-t2">{{item.title}}</text>
            <text class="ns-w2">{{item.why}}</text>
          </view>
          <text class="mwside">去办 ›</text>
        </view>
      </block>
      <view class="mwrow" wx:if="{{(!mw || !mw.count) && ns && !ns.item}}">
        <text class="mwdot">☕</text>
        <text class="mwmain">{{ns.text}}</text>
      </view>
      <view class="mwrow" wx:for="{{mw.recv}}" wx:key="id" bindtap="setTab" data-t="ar">
        <text class="mwdot red">收</text>
        <text class="mwmain">{{item.party}} · {{item.item}}　还欠 ¥{{item.left_amt}}</text>
        <text class="mwside {{item.late?'red':''}}">{{item.late ? '超 '+item.days+' 天' : '今天/3天内'}} ›</text>
      </view>
      <view class="mwrow" wx:for="{{mw.pay}}" wx:key="id" bindtap="setTab" data-t="ap">
        <text class="mwdot red">付</text>
        <text class="mwmain">{{item.party}} · {{item.item || '货款'}}　还差 ¥{{item.left_amt}}</text>
        <text class="mwside {{item.late?'red':''}}">{{item.late ? '超 '+item.days+' 天' : '今天/3天内'}} ›</text>
      </view>
      <view class="mwrow" wx:if="{{mw.wip && mw.wip.cnt>0}}" bindtap="openWipFromHome">
        <text class="mwdot">厂</text>
        <text class="mwmain">车间压着 ¥{{mw.wip.cost}}（{{mw.wip.cnt}} 张没交完，最久 {{mw.wip.max_idle}} 天没动）</text>
        <text class="mwside {{mw.wip.max_idle>=14?'red':''}}">看明细 ›</text>
      </view>
      <view class="mwrow" wx:if="{{mw.no_due_count>0}}" bindtap="setTab" data-t="contact">
        <text class="mwdot">期</text>
        <text class="mwmain">还有 {{mw.no_due_count}} 笔没约定收付款日（¥{{mw.no_due_amount}}）</text>
        <text class="mwside">去设账期 ›</text>
      </view>
