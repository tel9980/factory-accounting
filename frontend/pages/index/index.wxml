      <view class="empty" wx:elif="{{!trash_list.length}}">回收站是空的</view>
    </view>
    <view class="form">
      <view class="tip">操作日志（最近 100 条，防有人乱改账）</view>
      <view class="list" wx:if="{{audit_logs.length}}">
        <view class="item" wx:for="{{audit_logs}}" wx:key="id">
