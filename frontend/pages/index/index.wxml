<view class="page">
  <view class="bookbar" bindtap="setTab" data-t="contact">当前账套：{{book_name}}（点此切换 / 改名）</view>

  <view class="mtabs">
    <view class="mtab {{group=='home'?'on':''}}" bindtap="setGroup" data-g="home">工作台</view>
    <view class="mtab {{group=='bill'?'on':''}}" bindtap="setGroup" data-g="bill">记账</view>
    <view class="mtab {{group=='stat'?'on':''}}" bindtap="setGroup" data-g="stat">报表</view>
    <view class="mtab {{group=='me'?'on':''}}" bindtap="setGroup" data-g="me">设置</view>
  </view>

  <view class="subtabs" wx:if="{{group=='bill'}}">
    <view class="sub {{tab=='ar'?'on':''}}" bindtap="setTab" data-t="ar">应收<text class="sbadge" wx:if="{{ar_sum.open_count}}">{{ar_sum.open_count}}</text></view>
    <view class="sub {{tab=='ap'?'on':''}}" bindtap="setTab" data-t="ap">应付<text class="sbadge" wx:if="{{ap_sum.open_count}}">{{ap_sum.open_count}}</text></view>
    <view class="sub {{tab=='expense'?'on':''}}" bindtap="setTab" data-t="expense">支出</view>
    <view class="sub {{tab=='import'?'on':''}}" bindtap="setTab" data-t="import">导入</view>
  </view>
  <view class="subtabs" wx:if="{{group=='stat'}}">
    <view class="sub {{tab=='report'?'on':''}}" bindtap="setTab" data-t="report">报表</view>
    <view class="sub {{tab=='asset'?'on':''}}" bindtap="setTab" data-t="asset">家底</view>
    <view class="sub {{tab=='history'?'on':''}}" bindtap="setTab" data-t="history">历史</view>
  </view>
  <view class="subtabs" wx:if="{{group=='me'}}">
    <view class="sub on" bindtap="setTab" data-t="contact">单位 · 账户 · 设置</view>
  </view>

  <block wx:if="{{tab=='home'}}">
    <view class="form">
      <input class="inp qinp" placeholder="一句话记账：收张老板加工费5000" value="{{q_text}}" bindinput="onQText" bindconfirm="quick"/>
      <view class="qrow">
        <button class="btn" size="mini" bindtap="quick">记</button>
        <button class="btn btn-ghost" size="mini" bindtap="savePhrase">存为常用</button>
      </view>
      <view class="chips" wx:if="{{phrases.length}}">
        <view class="chip" wx:for="{{phrases}}" wx:key="id" bindtap="pickPhrase" data-t="{{item.text}}" bindlongpress="delPhrase" data-id="{{item.id}}">{{item.text}}</view>
      </view>
      <view class="tip">支持：收张老板5000 · 付王五金货款3000 · 工资5000 · 水电300；也可点输入框用键盘语音说话</view>
    </view>

    <view class="alertbar" wx:if="{{overdue_count > 0 || due_soon_count > 0 || pay_soon_count > 0}}" bindtap="jumpTodo">
      <view class="ab-t">今天要盯的款：{{due_brief}}</view>
      <view class="ab-a">去看 ›</view>
    </view>
    <view class="card ob" wx:if="{{onboard && onboard.show && !onboard.all_done}}">
      <view class="card-h">开账三步<text class="card-n">{{onboard.done}}/{{onboard.total}}</text></view>
      <view class="ob-tip">先把底数填上，欠款合计、毛利、手头现金才准。三步做完一次就行。</view>
      <view class="ob-item {{item.done?'done':''}}" wx:for="{{onboard.steps}}" wx:key="k" bindtap="onbGo" data-k="{{item.k}}">
        <text class="ob-dot">{{item.done?'✓':'○'}}</text>
        <view class="ob-body">
          <view class="ob-t">{{item.t}}</view>
          <view class="ob-d">{{item.d}}</view>
        </view>
        <text class="ob-a">{{item.done?'已完成':'去填 ›'}}</text>
      </view>
      <view class="ob-x" catchtap="onbDismiss">不再提示</view>
    </view>
    <view class="card" wx:if="{{rem_items.length}}">
      <view class="card-h">今天要做的事<text class="card-n">{{rem_items.length}}</text></view>
      <view wx:for="{{rem_items}}" wx:key="text" wx:for-item="ri">
        <view class="todo lv-{{ri.level}}" bindtap="goRem" data-tab="{{ri.tab}}">
          <text class="todo-dot"></text>
          <text class="todo-t">{{ri.text}}</text>
          <text class="todo-a">去处理 ›</text>
        </view>
        <view class="todo-list" wx:if="{{ri.list.length}}">
          <view class="todo-li" wx:for="{{ri.list}}" wx:for-item="li" wx:key="party">{{li.party}} ¥{{li.amount}} · {{li.note}}</view>
          <view class="todo-more" wx:if="{{ri.list.length >= 3}}">点上面这行进列表看全部 ›</view>
        </view>
      </view>
    </view>
    <view class="card" wx:if="{{!rem_items.length}}">
      <view class="card-h">今天要做的事</view>
      <view class="tip">没有到期欠款、没有超预算，账都是清的 👍</view>
    </view>

    <view class="grid4">
      <view class="g4" bindtap="setTab" data-t="ar">
        <view class="g4n">{{ar_total}}</view>
        <view class="g4l">客户欠我</view>
      </view>
      <view class="g4" bindtap="setTab" data-t="ap">
        <view class="g4n red">{{ap_total}}</view>
        <view class="g4l">我欠别人</view>
      </view>
      <view class="g4" bindtap="setTab" data-t="expense">
        <view class="g4n">{{today_income}}</view>
        <view class="g4l">今天收到</view>
      </view>
      <view class="g4" bindtap="setTab" data-t="report">
        <view class="g4n {{profit_biz < 0 ? 'red' : 'green'}}">{{profit_biz}}</view>
        <view class="g4l">本月经营毛利</view>
      </view>
    </view>
    <view class="monthline">本月 收 {{month_income}} · 付 {{month_outcome}} · 结余 {{month_profit}}</view>
    <view class="monthline" bindtap="setTab" data-t="contact">💰 手头现金合计 ¥{{cash_balance}}（点此管账户/改期初）</view>
    <view class="topcust" wx:if="{{top_customer}}">欠款最多：{{top_customer}} ¥{{top_unpaid}}</view>

    <view class="card">
      <view class="card-h">常用</view>
      <view class="qgrid">
        <view class="q" bindtap="setTab" data-t="ar"><view class="qi">＋</view><view class="qn">记应收</view></view>
        <view class="q" bindtap="setTab" data-t="ap"><view class="qi">＋</view><view class="qn">记应付</view></view>
        <view class="q" bindtap="setTab" data-t="expense"><view class="qi">＋</view><view class="qn">记支出</view></view>
        <view class="q" bindtap="setTab" data-t="ar"><view class="qi">收</view><view class="qn">收款核销</view></view>
        <view class="q" bindtap="setTab" data-t="import"><view class="qi">⊞</view><view class="qn">批量导入</view></view>
        <view class="q" bindtap="setTab" data-t="report"><view class="qi">▤</view><view class="qn">报表</view></view>
        <view class="q" bindtap="setTab" data-t="asset"><view class="qi">◱</view><view class="qn">家底</view></view>
        <view class="q" bindtap="setTab" data-t="contact"><view class="qi">☰</view><view class="qn">设置</view></view>
      </view>
    </view>

    <view class="form">
      <input class="inp" placeholder="全局搜索：客户名/产品/备注，查全部账" value="{{search_kw}}" bindinput="onSearchKw"/>
      <button class="btn btn-ghost" size="mini" bindtap="clearSearch" wx:if="{{search_kw}}">清空搜索</button>
    </view>
    <view class="searchres" wx:if="{{search_res}}">
      <view class="tip">共 {{search_res.total}} 条结果</view>
      <view class="item" wx:for="{{search_res.orders}}" wx:key="id" bindtap="goSearchTab" data-t="ar">
        <view class="row1"><text class="tag tag-ar">应收</text>{{item.customer}} · {{item.item_name}} · ¥{{item.price}}</view>
        <view class="row2">已收 ¥{{item.paid}} · 还欠 ¥{{item.unpaid}}</view>
      </view>
      <view class="item" wx:for="{{search_res.payables}}" wx:key="id" bindtap="goSearchTab" data-t="ap">
        <view class="row1"><text class="tag tag-ap">应付</text>{{item.supplier}} · ¥{{item.amount}}</view>
        <view class="row2">已付 ¥{{item.paid}} · 还欠 ¥{{item.unpaid}}</view>
      </view>
      <view class="item" wx:for="{{search_res.ledger}}" wx:key="id" bindtap="goSearchTab" data-t="expense">
        <view class="row1"><text class="tag tag-ex">{{item.direction=='in'?'收':'付'}}</text>{{item.category}} · ¥{{item.amount}}</view>
        <view class="row2">{{item.remark}} · {{item.created_at}}</view>
      </view>
      <view class="tip" wx:if="{{search_res.total == 0}}">没找到相关记录</view>
    </view>
  </block>

  <block wx:if="{{tab=='ar'}}">
    <view class="form">
      <input class="inp" placeholder="客户名" value="{{o_customer}}" bindinput="onOCustomer" bindblur="blurOCustomer"/>
      <view class="chips" wx:if="{{sug_ar.length}}">
        <text class="chip-label">常记：</text>
        <text class="chip" wx:for="{{sug_ar}}" wx:key="index" bindtap="fillSug" data-t="ar" data-i="{{index}}">{{item.party}} {{item.item}} {{item.amount}}</text>
      </view>
      <view class="tip" wx:if="{{last_tip}}">{{last_tip}}（已自动填好，改金额直接记）</view>
      <input class="inp" placeholder="产品/项目" value="{{o_item}}" bindinput="onOItem"/>
      <input class="inp" placeholder="加工费(元)" type="digit" value="{{o_price}}" bindinput="onOPrice"/>
      <input class="inp" placeholder="约定收款日(可选，如07-20)" value="{{o_due}}" bindinput="onODue"/>
      <input class="inp" placeholder="经手人(可选)" value="{{o_operator}}" bindinput="onOOperator"/>
      <view class="dateRow">
        <picker mode="date" data-f="o_date" bindchange="onDatePick" class="datePick">
          <view class="dateInp">{{o_date || '开单日期（默认今天）'}}</view>
        </picker>
        <text class="dateClr" wx:if="{{o_date}}" data-f="o_date" bindtap="clearDate">今天</text>
      </view>
      <button class="btn" size="mini" bindtap="addOrder">记一笔应收</button>
      <view class="chips" wx:if="{{contacts_ar.length}}">
        <text class="chip-label">常用客户：</text>
        <text class="chip" wx:for="{{contacts_ar}}" wx:key="name" wx:if="{{index < 8}}" bindtap="pickCustomer" data-n="{{item.name}}">{{item.name}}</text>
      </view>
    </view>
    <view class="form">
      <view class="tip">客户先给钱、活还没做 → 记预收款，开单后可一键抵扣</view>
      <input class="inp" placeholder="客户名" value="{{a_party}}" bindinput="onAParty"/>
      <input class="inp" placeholder="预收金额(元)" type="digit" value="{{a_amount}}" bindinput="onAAmount"/>
      <input class="inp" placeholder="备注(可选)" value="{{a_remark}}" bindinput="onARemark"/>
      <button class="btn" size="mini" bindtap="addAdvance">记一笔预收款</button>
      <view class="chips" wx:if="{{adv_in.length}}">
        <text class="chip-label">手上的预收：</text>
        <text class="chip" wx:for="{{adv_in}}" wx:key="id" bindtap="delAdvance" data-id="{{item.id}}" bindlongpress="delAdvance">{{item.party}} ¥{{item.remain}}（长按删）</text>
      </view>
    </view>
    <view class="form">
      <view class="tip">客户一次打款，自动抵多张单（先老后新）</view>
      <input class="inp" placeholder="客户名" value="{{rb_customer}}" bindinput="onRbCustomer"/>
      <input class="inp" placeholder="收到金额(元)" type="digit" value="{{rb_amount}}" bindinput="onRbAmount"/>
      <input class="inp" placeholder="收款日期(可选，如07-05)" value="{{rb_date}}" bindinput="onRbDate"/>
      <button class="btn" size="mini" bindtap="receiveBatch">批量核销收款</button>
      <button class="btn gray" size="mini" bindtap="dunning">生成催款清单</button>
      <view class="chips" wx:if="{{contacts_ar.length}}">
        <text class="chip-label">点客户名填入：</text>
        <text class="chip" wx:for="{{contacts_ar}}" wx:key="name" wx:if="{{index < 8}}" bindtap="pickRbCustomer" data-n="{{item.name}}">{{item.name}}</text>
      </view>
    </view>
    <view class="sumstrip">
      <view class="su"><view class="sun">{{ar_sum.open_amount || 0}}</view><view class="sul">未收合计 {{ar_sum.open_count || 0}} 单</view></view>
      <view class="su"><view class="sun red">{{ar_sum.overdue_amount || 0}}</view><view class="sul">逾期30天+ {{ar_sum.overdue_count || 0}} 单</view></view>
      <view class="su"><view class="sun org">{{ar_sum.due_amount || 0}}</view><view class="sul">7天内到期 {{ar_sum.due_count || 0}} 单</view></view>
      <view class="su"><view class="sun green">{{ar_sum.month_settled || 0}}</view><view class="sul">本月已收 · 新单 {{ar_sum.month_new || 0}}</view></view>
    </view>
    <view class="form">
      <input class="inp" placeholder="搜索客户/产品" value="{{ar_kw}}" bindinput="onArKw"/>
      <view class="chips">
        <text class="chip {{ar_filter==item.k?'on':''}}" wx:for="{{ar_filters}}" wx:key="k" bindtap="pickArFilter" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">排序：</text>
        <text class="chip {{ar_sort==item.k?'on':''}}" wx:for="{{ar_sorts}}" wx:key="k" bindtap="pickArSort" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">视图：</text>
        <text class="chip {{ar_view=='order'?'on':''}}" bindtap="pickArView" data-v="order">按单据</text>
        <text class="chip {{ar_view=='party'?'on':''}}" bindtap="pickArView" data-v="party">按客户</text>
      </view>
    </view>
    <view class="list" wx:if="{{ar_view=='party'}}">
      <view class="grp" wx:for="{{ar_groups}}" wx:key="name">
        <view class="grp-h" bindtap="toggleGroupAr" data-n="{{item.name}}">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{ar_open==item.name?'收起':'欠'+item.unpaid}}</text></view>
          <view class="row2">{{item.cnt}} 单 · 欠款合计 {{item.unpaid}} · 最久 {{item.oldest_days}} 天{{item.overdue>0?' · 逾期'+item.overdue+'单':''}}{{item.due_soon>0?' · 7天内到期'+item.due_soon+'单':''}}</view>
        </view>
        <view class="grp-b" wx:if="{{ar_open==item.name}}">
          <view class="gitem" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="row1"><text class="nm">{{it.title}}</text><text class="amt">欠{{it.unpaid}}</text></view>
            <view class="row2">总{{it.total}} · 已收{{it.paid}}{{it.written_off>0?' · 核销'+it.written_off:''}} · 已欠{{it.days}}天{{it.due_short?' · 约定'+it.due_short:''}}{{it.operator?' · '+it.operator:''}}</view>
            <view class="btns">
              <button size="mini" bindtap="receiveAll" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">收清</button>
              <button size="mini" bindtap="payOrder" data-id="{{it.id}}">收款</button>
              <button size="mini" bindtap="showDetail" data-id="{{it.id}}" data-type="ar">明细</button>
              <button size="mini" bindtap="editDue" data-id="{{it.id}}" data-type="ar" data-due="{{it.due_short}}">改期</button>
              <button size="mini" bindtap="writeoffOrder" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">核销</button>
            </view>
          </view>
          <view class="btns">
            <button size="mini" bindtap="groupReceive" data-n="{{item.name}}" data-amt="{{item.unpaid}}">整户收款</button>
            <button size="mini" bindtap="statement" data-type="ar" data-name="{{item.name}}">对账单</button>
            <button size="mini" bindtap="monthStatement" data-type="ar" data-name="{{item.name}}">月结</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!ar_groups.length}}">按{{ar_filter=='overdue'?'逾期':'未结'}}没有客户欠款</view>
    </view>
    <view class="list" wx:if="{{ar_view=='order'}}">
      <view class="item" wx:for="{{ar_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.customer}} · {{item.item_name}}</text><text class="amt">欠{{item.unpaid}}</text></view>
        <view class="row2">总{{item.price}} · 已收{{item.paid}}{{item.written_off>0?' · 核销'+item.written_off:''}} · 已欠{{item.days}}天{{item.due_short?' · 约定'+item.due_short:''}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="row2">{{item.status==2?'已交付':item.status==1?'加工中':'待加工'}}{{item.progress?' · 工序:'+item.progress:''}}{{item.settled?' · 已结清':''}}</view>
        <view class="btns">
          <button size="mini" bindtap="receiveAll" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}" wx:if="{{!item.settled}}">收清</button>
          <button size="mini" bindtap="showDetail" data-id="{{item.id}}" data-type="ar">明细</button>
          <button size="mini" bindtap="editDue" data-id="{{item.id}}" data-type="ar" data-due="{{item.due_short}}">改期</button>
          <button size="mini" bindtap="payOrder" data-id="{{item.id}}">收款</button>
          <button size="mini" bindtap="finishOrder" data-id="{{item.id}}">交付</button>
          <button size="mini" bindtap="editProgress" data-id="{{item.id}}">进度</button>
          <button size="mini" bindtap="applyAdvanceOrder" data-id="{{item.id}}">预收抵</button>
          <button size="mini" bindtap="writeoffOrder" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}">核销</button>
          <button size="mini" bindtap="editOrder" data-id="{{item.id}}">改</button>
          <button size="mini" bindtap="statement" data-type="ar" data-name="{{item.customer}}">对账</button>
          <button size="mini" bindtap="monthStatement" data-type="ar" data-name="{{item.customer}}">月结</button>
          <button size="mini" bindtap="delOrder" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!ar_list.length}}">{{ar_filter=='closed'?'没有已结清的应收':'没有未结清的应收'}}</view>
      <view class="loadmore" wx:if="{{ar_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ar_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

  <block wx:if="{{tab=='ap'}}">
    <view class="form">
      <input class="inp" placeholder="供应商/收款人" value="{{p_supplier}}" bindinput="onPSupplier" bindblur="blurPSupplier"/>
      <view class="chips" wx:if="{{sug_ap.length}}">
        <text class="chip-label">常记：</text>
        <text class="chip" wx:for="{{sug_ap}}" wx:key="index" bindtap="fillSug" data-t="ap" data-i="{{index}}">{{item.party}} {{item.item}} {{item.amount}}</text>
      </view>
      <view class="tip" wx:if="{{last_tip}}">{{last_tip}}</view>
      <input class="inp" placeholder="金额(元)" type="digit" value="{{p_amount}}" bindinput="onPAmount"/>
      <input class="inp" placeholder="备注(可选)" value="{{p_remark}}" bindinput="onPRemark"/>
      <input class="inp" placeholder="约定付款日(可选，如07-20)" value="{{p_due}}" bindinput="onPDue"/>
      <input class="inp" placeholder="经手人(可选)" value="{{p_operator}}" bindinput="onPOperator"/>
      <view class="dateRow">
        <picker mode="date" data-f="p_date" bindchange="onDatePick" class="datePick">
          <view class="dateInp">{{p_date || '发生日期（默认今天）'}}</view>
        </picker>
        <text class="dateClr" wx:if="{{p_date}}" data-f="p_date" bindtap="clearDate">今天</text>
      </view>
      <button class="btn" size="mini" bindtap="addPayable">记一笔应付</button>
      <view class="chips" wx:if="{{contacts_ap.length}}">
        <text class="chip-label">常用供应商：</text>
        <text class="chip" wx:for="{{contacts_ap}}" wx:key="name" wx:if="{{index < 8}}" bindtap="pickSupplier" data-n="{{item.name}}">{{item.name}}</text>
      </view>
    </view>
    <view class="form">
      <view class="tip">先付了定金、货还没到 → 记预付款，到货后可一键抵扣</view>
      <input class="inp" placeholder="供应商名" value="{{a_party}}" bindinput="onAParty"/>
      <input class="inp" placeholder="预付金额(元)" type="digit" value="{{a_amount}}" bindinput="onAAmount"/>
      <input class="inp" placeholder="备注(可选)" value="{{a_remark}}" bindinput="onARemark"/>
      <button class="btn" size="mini" bindtap="addAdvancePre">记一笔预付款</button>
      <view class="chips" wx:if="{{adv_out.length}}">
        <text class="chip-label">已付的预付：</text>
        <text class="chip" wx:for="{{adv_out}}" wx:key="id" bindtap="delAdvance" data-id="{{item.id}}" bindlongpress="delAdvance">{{item.party}} ¥{{item.remain}}（长按删）</text>
      </view>
    </view>
    <view class="sumstrip">
      <view class="su"><view class="sun">{{ap_sum.open_amount || 0}}</view><view class="sul">未付合计 {{ap_sum.open_count || 0}} 笔</view></view>
      <view class="su"><view class="sun red">{{ap_sum.overdue_amount || 0}}</view><view class="sul">超30天没付 {{ap_sum.overdue_count || 0}} 笔</view></view>
      <view class="su"><view class="sun org">{{ap_sum.due_amount || 0}}</view><view class="sul">7天内要付 {{ap_sum.due_count || 0}} 笔</view></view>
      <view class="su"><view class="sun green">{{ap_sum.month_settled || 0}}</view><view class="sul">本月已付 · 新增 {{ap_sum.month_new || 0}}</view></view>
    </view>
    <view class="form">
      <input class="inp" placeholder="搜索供应商/备注" value="{{ap_kw}}" bindinput="onApKw"/>
      <view class="chips">
        <text class="chip {{ap_filter==item.k?'on':''}}" wx:for="{{ar_filters}}" wx:key="k" bindtap="pickApFilter" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">排序：</text>
        <text class="chip {{ap_sort==item.k?'on':''}}" wx:for="{{ar_sorts}}" wx:key="k" bindtap="pickApSort" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">视图：</text>
        <text class="chip {{ap_view=='order'?'on':''}}" bindtap="pickApView" data-v="order">按单据</text>
        <text class="chip {{ap_view=='party'?'on':''}}" bindtap="pickApView" data-v="party">按供应商</text>
      </view>
    </view>
    <view class="list" wx:if="{{ap_view=='party'}}">
      <view class="grp" wx:for="{{ap_groups}}" wx:key="name">
        <view class="grp-h" bindtap="toggleGroupAp" data-n="{{item.name}}">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{ap_open==item.name?'收起':'欠'+item.unpaid}}</text></view>
          <view class="row2">{{item.cnt}} 笔 · 欠款合计 {{item.unpaid}} · 最久 {{item.oldest_days}} 天{{item.overdue>0?' · 超30天'+item.overdue+'笔':''}}{{item.due_soon>0?' · 7天内要付'+item.due_soon+'笔':''}}</view>
        </view>
        <view class="grp-b" wx:if="{{ap_open==item.name}}">
          <view class="gitem" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="row1"><text class="nm">{{it.title}}</text><text class="amt">欠{{it.unpaid}}</text></view>
            <view class="row2">总{{it.total}} · 已付{{it.paid}}{{it.written_off>0?' · 核销'+it.written_off:''}} · 已欠{{it.days}}天{{it.due_short?' · 约定'+it.due_short:''}}</view>
            <view class="btns">
              <button size="mini" bindtap="payAll" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">付清</button>
              <button size="mini" bindtap="payPayable" data-id="{{it.id}}">付款</button>
              <button size="mini" bindtap="showDetail" data-id="{{it.id}}" data-type="ap">明细</button>
              <button size="mini" bindtap="editDue" data-id="{{it.id}}" data-type="ap" data-due="{{it.due_short}}">改期</button>
              <button size="mini" bindtap="writeoffPayable" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">核销</button>
            </view>
          </view>
          <view class="btns">
            <button size="mini" bindtap="groupPay" data-n="{{item.name}}" data-amt="{{item.unpaid}}">整户付款</button>
            <button size="mini" bindtap="statement" data-type="ap" data-name="{{item.name}}">对账单</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!ap_groups.length}}">按{{ap_filter=='overdue'?'超30天':'未结'}}没有供应商欠款</view>
    </view>
    <view class="list" wx:if="{{ap_view=='order'}}">
      <view class="item" wx:for="{{ap_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.supplier}}</text><text class="amt">欠{{item.unpaid}}</text></view>
        <view class="row2">总{{item.amount}} · 已付{{item.paid}}{{item.written_off>0?' · 核销'+item.written_off:''}} · 已欠{{item.days}}天{{item.due_short?' · 约定'+item.due_short:''}}{{item.remark ? ' · ' + item.remark : ''}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="btns">
          <button size="mini" bindtap="payAll" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}" wx:if="{{!item.settled}}">付清</button>
          <button size="mini" bindtap="showDetail" data-id="{{item.id}}" data-type="ap">明细</button>
          <button size="mini" bindtap="editDue" data-id="{{item.id}}" data-type="ap" data-due="{{item.due_short}}">改期</button>
          <button size="mini" bindtap="payPayable" data-id="{{item.id}}">付款</button>
          <button size="mini" bindtap="applyAdvancePayable" data-id="{{item.id}}">预付抵</button>
          <button size="mini" bindtap="writeoffPayable" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}">核销</button>
          <button size="mini" bindtap="editPayable" data-id="{{item.id}}">改</button>
          <button size="mini" bindtap="statement" data-type="ap" data-name="{{item.supplier}}">对账</button>
          <button size="mini" bindtap="monthStatement" data-type="ap" data-name="{{item.supplier}}">月结</button>
          <button size="mini" bindtap="delPayable" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!ap_list.length}}">{{ap_filter=='closed'?'没有已结清的应付':'没有未结清的应付'}}</view>
      <view class="loadmore" wx:if="{{ap_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ap_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

  <block wx:if="{{tab=='expense'}}">
    <view class="form">
      <picker range="{{categories}}" bindchange="onECategory"><view class="picker">分类：{{categories[e_category]}} ▾</view></picker>
      <picker range="{{acc_names}}" bindchange="onEAcc"><view class="picker">付自：{{acc_names[e_acc] || '现金'}} ▾</view></picker>
      <view class="chips" wx:if="{{sug_ex.length}}">
        <text class="chip-label">常记：</text>
        <text class="chip" wx:for="{{sug_ex}}" wx:key="index" bindtap="fillSug" data-t="ex" data-i="{{index}}">{{item.party}} {{item.amount}}</text>
      </view>
      <input class="inp" placeholder="金额(元)" type="digit" value="{{e_amount}}" bindinput="onEAmount"/>
      <input class="inp" placeholder="备注(可选)" value="{{e_remark}}" bindinput="onERemark"/>
      <input class="inp" placeholder="经手人(可选)" value="{{e_operator}}" bindinput="onEOperator"/>
      <view class="dateRow">
        <picker mode="date" data-f="e_date" bindchange="onDatePick" class="datePick">
          <view class="dateInp">{{e_date || '日期（默认今天）'}}</view>
        </picker>
        <text class="dateClr" wx:if="{{e_date}}" data-f="e_date" bindtap="clearDate">今天</text>
      </view>
      <button class="btn" size="mini" bindtap="addExpense">记支出</button>
    </view>

    <view class="form">
      <view class="tip">员工借支 / 报销（借出先记账不冲成本，报销时按分类记支出，冲借支不动现金）<text wx:if="{{loan_open}}"> · 未清 ¥{{loan_open}}</text></view>
      <input class="inp" placeholder="员工姓名" value="{{l_staff}}" bindinput="onLStaff"/>
      <input class="inp" placeholder="借出金额(元)" type="digit" value="{{l_amount}}" bindinput="onLAmount"/>
      <input class="inp" placeholder="用途备注(可选)" value="{{l_remark}}" bindinput="onLRemark"/>
      <button class="btn" size="mini" bindtap="addLoan">借出</button>

      <view class="reimb" wx:if="{{cur_loan}}">
        <view class="tip">正在报销：{{cur_loan_name}}</view>
        <picker range="{{categories}}" bindchange="onRlCategory"><view class="picker">分类：{{categories[rl_category] || '其他'}} ▾</view></picker>
        <input class="inp" placeholder="报销金额(默认全部结清)" type="digit" value="{{rl_amount}}" bindinput="onRlAmount"/>
        <input class="inp" placeholder="备注(可选)" value="{{rl_remark}}" bindinput="onRlRemark"/>
        <view class="btns">
          <button size="mini" bindtap="doReimburse">确认报销</button>
          <button size="mini" bindtap="cancelReimburse">取消</button>
        </view>
      </view>

      <view class="list">
        <view class="item" wx:for="{{loans}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.staff}}</text><text class="amt out">借 {{item.amount}}</text></view>
          <view class="row2">已报 {{item.used}} · 退回 {{item.returned}} · 未清 {{item.remain}}{{item.remark?' · '+item.remark:''}}</view>
          <view class="btns">
            <button size="mini" wx:if="{{item.remain>0}}" bindtap="startReimburse" data-id="{{item.id}}" data-name="{{item.staff}}" data-remain="{{item.remain}}">报销</button>
            <button size="mini" wx:if="{{item.remain>0}}" bindtap="returnLoan" data-id="{{item.id}}" data-remain="{{item.remain}}">退回余款</button>
            <button size="mini" wx:if="{{item.used==0 && item.returned==0}}" bindtap="delLoan" data-id="{{item.id}}">删</button>
          </view>
        </view>
        <view class="empty" wx:if="{{!loans.length}}">还没有员工借支</view>
      </view>
    </view>
    <view class="form">
      <input class="inp" placeholder="搜索分类/备注" value="{{ex_kw}}" bindinput="onExKw"/>
    </view>
    <view class="list">
      <view class="item" wx:for="{{expense_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.category}}</text><text class="amt out">{{item.amount}}</text></view>
        <view class="row2">{{item.remark}} · {{item.created_at}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="btns">
          <button size="mini" bindtap="editExpense" data-id="{{item.id}}">改</button>
          <button size="mini" bindtap="delExpense" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!expense_list.length}}">暂无支出记录</view>
      <view class="loadmore" wx:if="{{ex_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ex_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

  <block wx:if="{{tab=='import'}}">
    <view class="form">
      <picker range="{{import_types}}" bindchange="onImportType"><view class="picker">{{import_types[import_type]}} ▾</view></picker>
      <button class="btn" size="mini" bindtap="excelTemplate">⬇ 下载 Excel 模板（.xlsx，推荐）</button>
      <button class="btn" size="mini" bindtap="chooseXlsxFile">📊 选 Excel 文件直接导入</button>
      <button class="btn ghost" size="mini" bindtap="exportTemplate">⬇ 老办法：导出 CSV 模板</button>
      <button class="btn btn-ghost" size="mini" bindtap="chooseImportFile">📄 选 CSV/TXT 文件导入</button>
      <view class="tip" wx:if="{{import_file_name}}">已读入：{{import_file_name}}</view>
      <textarea class="ta" placeholder="{{import_hint}}" value="{{import_text}}" bindinput="onImportText"></textarea>
      <button class="btn" size="mini" bindtap="doImport">开始导入</button>
      <view class="tip">最省事的两步：① 点「下载 Excel 模板」→ 转发到电脑，用 Excel/WPS 填几行（表头别删，日期可留空）→ 微信发回给自己；② 回到这里点「选 Excel 文件直接导入」。Excel 存什么编码都能读，不用另存 CSV。也可以直接从 Excel 复制多行粘到上面的框里。</view>
    </view>
  </block>

  <block wx:if="{{tab=='report'}}">
    <view class="form">
      <view class="tip">赚没赚（两种算法，看你想看什么）</view>
      <input class="inp" placeholder="月份，如 2026-11（不填=本月）" value="{{pc_month}}" bindinput="onPcMonth"/>
      <button class="btn" size="mini" bindtap="loadProfitCompare">算一下</button>
      <view class="pc" wx:if="{{pc}}">
        <view class="pc-row">
          <view class="pc-t">手里钱变多没有？<text class="pc-s">（现金口径）</text></view>
          <view class="pc-n {{pc.cash_profit>=0?'ok':'bad'}}">{{pc.cash_profit}} 元</view>
          <view class="pc-sub">本月实收 {{pc.cash_income}} − 本月实付 {{pc.cash_outcome}}</view>
          <view class="pc-sub">看的是真金白银，收到钱才算，付出去就扣。</view>
        </view>
        <view class="pc-row">
          <view class="pc-t">这个月活干得值不值？<text class="pc-s">（经营口径）</text></view>
          <view class="pc-n {{pc.accrual_profit>=0?'ok':'bad'}}">{{pc.accrual_profit}} 元</view>
          <view class="pc-sub">本月接单 {{pc.order_add}} − 本月赊购 {{pc.payable_add}} − 现金成本 {{pc.cost_cash}}</view>
          <view class="pc-sub">看的是干活挣的，钱还没收到也算。</view>
        </view>
        <view class="pc-gap">两者差 {{pc.gap}} 元：差在「活干了钱还没收」和「钱收了活还没干」。</view>
      </view>
    </view>
    <view class="form">
      <input class="inp" placeholder="年份，如 2026" value="{{report_year}}" bindinput="onReportYear"/>
      <button class="btn" size="mini" bindtap="genReport">生成年度报表</button>
    </view>
    <view class="chart" wx:if="{{chart.length}}">
      <view class="chart-title">月度收付对比（蓝=收 橙=付）</view>
      <view class="bar-line" wx:for="{{chart}}" wx:key="m">
        <view class="bar-m">{{item.m_short}}月</view>
        <view class="bar-zone">
          <view class="bar bar-in" style="width:{{item.inc_w}}%"></view>
          <text class="bar-num">{{item.inc}}</text>
        </view>
        <view class="bar-zone">
          <view class="bar bar-out" style="width:{{item.out_w}}%"></view>
          <text class="bar-num">{{item.out}}</text>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">经营分析</view>
      <button class="btn" size="mini" bindtap="genCredits">客户欠款榜</button>
      <input class="inp" placeholder="月份，如 2026-11（不填=本月）" value="{{cmp_month}}" bindinput="onCmpMonth"/>
      <button class="btn" size="mini" bindtap="genCompare">同比环比</button>
      <button class="btn" size="mini" bindtap="genSelfcheck">数据自检</button>
    </view>
    <view class="list" wx:if="{{analysis_text}}">
      <view class="item">
        <view class="row2 pre">{{analysis_text}}</view>
        <view class="btns">
          <button size="mini" bindtap="copyAnalysis">复制</button>
          <button size="mini" bindtap="analysisImage">生成图片</button>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">整月全部数据导成一个 Excel（6 个表：总览/应收/应付/收付流水/借支/核销），直接发会计或存档</view>
      <input class="inp" placeholder="月份，如 2026-11（不填=本月）" value="{{ex_month}}" bindinput="onExMonth"/>
      <button class="btn" size="mini" bindtap="exportMonthXlsx">⬇ 导出整月 Excel（多表）</button>
      <button class="btn" size="mini" bindtap="exportCsv" data-type="orders">导出应收(文件)</button>
      <button class="btn" size="mini" bindtap="exportCsv" data-type="payables">导出应付(文件)</button>
      <button class="btn" size="mini" bindtap="exportCsv" data-type="ledger">导出流水(文件)</button>
      <button class="btn" size="mini" bindtap="backup">备份全部数据</button>
      <button class="btn" size="mini" bindtap="cloudBackup">云端备份</button>
      <button class="btn" size="mini" bindtap="backupToNotes">备份到笔记站</button>
      <button class="btn" size="mini" bindtap="changeKey">改口令</button>
    </view>
    <view class="form">
      <textarea class="inp restore-ta" placeholder="粘贴备份文本（在报表页先点「备份全部数据」复制的那段 JSON）" value="{{restore_text}}" bindinput="onRestoreInput"></textarea>
      <button class="btn" size="mini" bindtap="restoreData">从备份恢复</button>
    </view>
    <view class="form">
      <view class="tip">固定支出（每月自动记一笔，如工资、房租）</view>
      <input class="inp" placeholder="金额" type="digit" value="{{f_amount}}" bindinput="onFAmount"/>
      <picker range="{{categories}}" value="{{f_category}}" bindchange="onFCategory">
        <view class="inp picker">{{categories[f_category]}}</view>
      </picker>
      <input class="inp" placeholder="每月几号记（1-28）" type="number" value="{{f_day}}" bindinput="onFDay"/>
      <input class="inp" placeholder="备注，如 3月工资" value="{{f_remark}}" bindinput="onFRemark"/>
      <button class="btn" size="mini" bindtap="addFixed">添加固定支出</button>
      <button class="btn" size="mini" bindtap="runFixed">立即补记本月</button>
      <view class="list" wx:if="{{fixed_list.length}}">
        <view class="item" wx:for="{{fixed_list}}" wx:key="id">
          <view class="row1">{{item.remark || item.category}} · 每月{{item.day}}号 · ¥{{item.amount}}</view>
          <view class="row2">{{item.category}}<button size="mini" bindtap="delFixed" data-id="{{item.id}}">删</button></view>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">支出预算（按分类设月度额度，用到 90% 或超了首页提醒）</view>
      <picker range="{{categories}}" value="{{b_category}}" bindchange="onBCategory">
        <view class="inp picker">{{categories[b_category]}}</view>
      </picker>
      <input class="inp" placeholder="每月额度，如 5000" type="digit" value="{{b_amount}}" bindinput="onBAmount"/>
      <button class="btn" size="mini" bindtap="saveBudget">保存预算</button>
      <view class="list" wx:if="{{budgets.length}}">
        <view class="item" wx:for="{{budgets}}" wx:key="id">
          <view class="row1">{{item.category}} · 每月 ¥{{item.amount}}</view>
          <view class="row2">设于 {{item.created_at}}<button size="mini" bindtap="delBudget" data-id="{{item.id}}">删</button></view>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">月度结账锁定（锁住后该月账目不能改，防误动）</view>
      <input class="inp" placeholder="月份，如 2026-11" value="{{lock_month}}" bindinput="onLockMonth"/>
      <button class="btn" size="mini" bindtap="lockMonth">锁定该月</button>
      <view class="list" wx:if="{{month_locks.length}}">
        <view class="item" wx:for="{{month_locks}}" wx:key="month">
          <view class="row1">已锁定：{{item.month}}</view>
          <view class="row2">锁定于 {{item.locked_at}}<button size="mini" bindtap="unlockMonth" data-m="{{item.month}}">解锁</button></view>
        </view>
      </view>
    </view>
    <view class="form">
      <view class="tip">回收站（删掉的账先放这里，30 天内可恢复）</view>
      <view class="list" wx:if="{{trash_list.length}}">
        <view class="item" wx:for="{{trash_list}}" wx:key="batch">
          <view class="row1">{{item.items.length}} 条 · 删除于 {{item.deleted_at}}</view>
          <view class="row2 pre">{{item.items}}</view>
          <view class="btns">
            <button size="mini" bindtap="restoreTrash" data-id="{{item.ids[0]}}">恢复</button>
            <button size="mini" bindtap="purgeTrash" data-id="{{item.ids[0]}}">彻底删除</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!trash_list.length}}">回收站是空的</view>
    </view>
    <view class="form">
      <view class="tip">操作日志（最近 100 条，防有人乱改账）</view>
      <view class="list" wx:if="{{audit_logs.length}}">
        <view class="item" wx:for="{{audit_logs}}" wx:key="id">
          <view class="row1">{{item.action}}{{item.target ? ' · ' + item.target : ''}}</view>
          <view class="row2">{{item.detail}} · {{item.created_at}}</view>
        </view>
      </view>
      <view class="tip" wx:else>暂无操作记录</view>
    </view>
    <view class="tip" wx:if="{{cloud_backup_at}}">最近云端备份：{{cloud_backup_at}}（每天自动备份一次）</view>
    <view class="list" wx:if="{{report_text}}">
      <view class="item">
        <view class="row2 pre">{{report_text}}</view>
        <view class="btns">
          <button size="mini" bindtap="copyReport">复制报表</button>
          <button size="mini" bindtap="genReportImage">生成图片</button>
        </view>
      </view>
    </view>
  </block>

