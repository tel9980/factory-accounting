        <view class="row2 pre">{{mr_text}}</view>
        <view class="btns">
          <button size="mini" bindtap="copyMonthReport">复制</button>
          <button size="mini" bindtap="mrImage">生成图片</button>
        </view>
      </view>
    </view>


    <view class="form">
