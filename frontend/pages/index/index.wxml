        <view class="row2">总 ¥{{item.price}}{{item.ar_cat ? ' · ' + item.ar_cat : ''}}{{item.tax_kind ? '(' + item.tax_kind + (item.tax_rate ? item.tax_rate + '%':'') + '，税' + item.tax_amt + ')' : ''}} · 已收 ¥{{item.paid}}{{item.written_off>0?' · 核销'+item.written_off:''}} · 已欠{{item.days}}天{{item.due_short?' · 约定'+item.due_short:''}}{{item.operator?' · '+item.operator:''}}</view>
