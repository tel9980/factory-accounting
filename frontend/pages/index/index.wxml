          <button size="mini" bindtap="copyReport">复制报表</button>
          <button size="mini" bindtap="genReportImage">生成图片</button>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{tab=='asset'}}">
    <view class="cards" wx:if="{{nw_latest}}">
      <view class="card">
        <view class="num">{{nw_latest.net}}</view>
        <view class="label">家底（现金+别人欠我−我欠别人−借款）</view>
      </view>
      <view class="card">
        <view class="num">{{nw_latest.cash}}</view>
        <view class="label">手里现金</view>
      </view>
    </view>
    <view class="tip" wx:if="{{nw_latest}}">这个「家底」不算押金、借支、预付款：押金是要退回来的，借支会报销冲掉，预付是还没花掉的成本——算进去反而看不出真实家底。这三样在下面各自一行。</view>
    <view class="biz" wx:if="{{nw_latest}}">
      <text>别人欠我</text><text class="amt">{{nw_latest.ar}}</text>
    </view>
    <view class="biz" wx:if="{{nw_latest}}">
      <text>我欠别人</text><text class="amt out">{{nw_latest.ap}}</text>
    </view>

    <view class="form">
      <view class="tip">🏦 借款台账（银行 / 亲友）{{debt_sum.count ? '：共 ' + debt_sum.count + ' 笔，还欠 ' + debt_sum.total_principal + ' 元，每月利息约 ' + debt_sum.month_interest + ' 元' : ''}}</view>
      <view class="debt-add" wx:if="{{role!='staff'}}">
        <input class="inp" placeholder="出借方（如 XX 银行 / 张三）" value="{{d_lender}}" bindinput="onDLender"/>
        <view class="frow">
          <picker range="{{debt_kinds}}" value="{{d_kind}}" bindchange="onDKind"><view class="picker">类型：{{debt_kinds[d_kind]}} ▾</view></picker>
          <input class="inp half" placeholder="本金" type="digit" value="{{d_principal}}" bindinput="onDPrincipal"/>
        </view>
        <view class="amts"><view class="amtx" wx:for="{{amts}}" wx:key="*this" bindtap="fillAmt" data-f="d_principal" data-v="{{item}}">{{item}}</view></view>
        <view class="frow">
          <input class="inp half" placeholder="年利率 %" type="digit" value="{{d_rate}}" bindinput="onDRate"/>
          <input class="inp half" placeholder="几期(月)" type="number" value="{{d_term}}" bindinput="onDTerm"/>
        </view>
        <view class="frow">
          <picker range="{{debt_paykinds}}" value="{{d_paykind}}" bindchange="onDPayKind"><view class="picker">还款方式：{{debt_paykinds[d_paykind]}} ▾</view></picker>
        </view>
        <view class="frow">
          <picker mode="date" value="{{d_start}}" bindchange="onDStart"><view class="picker">起借日：{{d_start || '今天'}} ▾</view></picker>
        </view>
        <input class="inp" placeholder="备注（可不填）" value="{{d_remark}}" bindinput="onDRemark"/>
        <button class="btn" size="mini" bindtap="addDebt">记一笔借款（钱进账户）</button>
        <button class="btn" size="mini" bindtap="runAccrual">补提本月利息（自动记成本）</button>
      </view>
      <view class="list" wx:if="{{debts.length}}">
        <view class="item" wx:for="{{debts}}" wx:key="id">
          <view class="row1"><text class="nm ellip">{{item.lender}}</text><text class="amt out">还欠 ¥{{item.remain}}</text></view>
          <view class="row2">{{item.kind_name}} · 年息 {{item.rate}}% · 月息 {{item.monthly_interest}} 元 · {{item.pay_kind_name}}</view>
          <view class="row2" wx:if="{{item.status=='open'}}">下次还款 {{item.next_due}} 约 {{item.next_amount}} 元<text class="red" wx:if="{{item.overdue}}"> · 已逾期，快处理</text></view>
          <view class="row2" wx:else>已还清</view>
          <view class="btns">
            <button size="mini" wx:if="{{item.status=='open'}}" bindtap="repayDebt" data-id="{{item.id}}">还款</button>
            <button size="mini" bindtap="repayDebt" data-id="{{item.id}}">计划</button>
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="delDebt" data-id="{{item.id}}">删</button>
          </view>
        </view>
      </view>
      <view class="tip" wx:else>还没有借款记录。有银行贷款或亲友借款就记一笔，每月利息会自动算，到期前提醒你。</view>
    </view>

    <view class="form">
      <view class="tip">🗓 付给房东的钱（厂房租金、宿舍租金、水费、电费按月摊；押金月数填 0，不摊、退租时收回）{{prepaid_sum.open_count ? '：' + prepaid_sum.open_count + ' 项在摊，每月约 ' + prepaid_sum.month_amount + ' 元，还没摊完 ' + prepaid_sum.total_left + ' 元' : ''}}</view>
      <view class="debt-add" wx:if="{{role!='staff'}}">
        <input class="inp" placeholder="名称（如 11月厂房租金 / 宿舍押金）" value="{{pp_name}}" bindinput="onPPName"/>
        <view class="frow">
          <input class="inp half" placeholder="一共付了多少" type="digit" value="{{pp_total}}" bindinput="onPPTotal"/>
          <input class="inp half" placeholder="摊几个月（0=押金不摊）" type="number" value="{{pp_months}}" bindinput="onPPMonths"/>
        </view>
        <view class="amts"><view class="amtx" wx:for="{{amts}}" wx:key="*this" bindtap="fillAmt" data-f="pp_total" data-v="{{item}}">{{item}}</view></view>
        <view class="frow">
          <block wx:for="{{pp_cats}}" wx:key="*this">
            <text class="chip {{pp_cat==item?'on':''}}" bindtap="pickPPCat" data-k="{{item}}">{{item}}</text>
          </block>
        </view>
        <view class="frow">
          <picker mode="date" value="{{pp_start}}" bindchange="onPPStart"><view class="picker">付款日：{{pp_start || '今天'}} ▾</view></picker>
        </view>
        <button class="btn" size="mini" bindtap="addPrepaid">记一笔（钱先付出去，成本按月摊）</button>
        <button class="btn" size="mini" bindtap="runAmort">补摊本月（有漏掉的月份就点这里）</button>
      </view>
      <view class="list" wx:if="{{prepaids.length}}">
        <view class="item" wx:for="{{prepaids}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{item.active=='open' ? '还没摊 ' + item.remain : '已摊完'}}</text></view>
          <view class="row2">总额 {{item.total}} · {{item.deposit ? '押金，不摊（退租时收回）' : '每月 ' + item.per_month + ' · 已摊 ' + item.amortized + '（' + item.done_months + '/' + item.months + ' 个月）'}}</view>
          <view class="row2" wx:if="{{item.next_month}}">下次摊销 {{item.next_month}} 约 {{item.per_month}} 元</view>
          <view class="btns">
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="togglePrepaid" data-id="{{item.id}}" data-active="{{item.active}}">{{item.active=='open' ? '停摊' : '继续摊'}}</button>
            <button size="mini" wx:if="{{role!='staff'}}" bindtap="delPrepaid" data-id="{{item.id}}">删</button>
          </view>
        </view>
      </view>
      <view class="tip" wx:else>还没有预付费用要摊销。比如一次交了 1 年房租 1.2 万，记成 12 个月摊：钱当天出账，成本每月只算 1000，利润不会某个月特别难看。</view>
    </view>

    <view class="chart" wx:if="{{nw.length}}">
      <view class="chart-title">近 12 个月家底变化（数字=净资产）</view>
      <view class="bar-line" wx:for="{{nw}}" wx:key="m">
        <view class="bar-m">{{item.m}}</view>
        <view class="bar-zone">
          <view class="bar bar-in" style="width:{{item.w}}%"></view>
          <text class="bar-num">{{item.net}}</text>
        </view>
      </view>
    </view>

    <view class="form" wx:if="{{nws}}">
      <view class="tip">📌 家底存档（每月最后一天自动存一份；改了老单据也不会带偏已存的数）</view>
      <view class="aline" wx:for="{{nws.advice}}" wx:key="*this">{{item}}</view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="saveNetworthSnap">{{nws.has_this_month?'重存这个月':'记下这个月的家底'}}</button>
      </view>
      <view class="tip" wx:if="{{nws.current}}">现在算出来：现金 {{nws.current.cash}}、别人欠我 {{nws.current.ar}}、我欠别人 {{nws.current.ap}}、借款 {{nws.current.debt}} → 净资产 {{nws.current.net}} 元</view>
      <view class="item" wx:for="{{nws.rows}}" wx:key="month">
        <view class="row1">
          <text class="nm">{{item.month}} 净资产 ¥{{item.net}}</text>
          <text class="amt" wx:if="{{item.delta!==null}}">{{item.delta>=0?'比上月 +':'比上月 '}}{{item.delta}}</text>
        </view>
        <view class="row2">现金 {{item.cash}} · 应收 {{item.ar}} · 应付 {{item.ap}} · 借款 {{item.debt}}</view>
        <view class="row2" wx:if="{{item.drift}}">⚠ 现在重新算是 {{item.live_net}}（差 {{item.drift}}，说明这月的单据后来改过）</view>
        <view class="row2" wx:if="{{item.note}}">{{item.note}}</view>
        <button class="btn ghost" size="mini" wx:if="{{role!='staff'}}" bindtap="delNetworthSnap" data-m="{{item.month}}">删</button>
      </view>
      <view class="tip" wx:if="{{!nws.rows.length}}">还没有存档。到月底会自动存；想现在留个底就点上面的按钮。</view>
    </view>

    <view class="form" wx:if="{{kpi}}">
      <view class="tip">财务指标（{{kpi.month}}）</view>
      <view class="kpi-row"><text>本月赚的（收 − 付）</text><text class="kpi-n {{kpi.profit>=0?'ok':'bad'}}">{{kpi.profit}}（收 {{kpi.cash_in}} − 付 {{kpi.cash_out}}）</text></view>
      <view class="kpi-row"><text>净利率（净利 ÷ 本月收款）</text><text class="kpi-n {{kpi.margin>=0?'ok':'bad'}}">{{kpi.margin}}%（按单子算的权责净利 {{kpi.profit_accrual}}）</text></view>
      <view class="kpi-row"><text>平均回款天数</text><text class="kpi-n">{{kpi.avg_days}} 天</text></view>
      <view class="kpi-row"><text>应收周转天数</text><text class="kpi-n">{{kpi.turn_days}} 天</text></view>
      <view class="kpi-row"><text>现金能撑几个月</text><text class="kpi-n {{kpi.cushion_months>=1?'ok':'bad'}}">{{kpi.cushion_months}} 个月</text></view>
      <view class="kpi-row" wx:if="{{kpi.top_customer}}"><text>最大客户占比</text><text class="kpi-n {{kpi.conc_pct>=60?'bad':''}}">{{kpi.top_customer}} {{kpi.conc_pct}}%</text></view>
      <view class="kpi-row"><text>本月成本合计</text><text class="kpi-n">{{kpi.cost_total}}（材料 {{kpi.mat_cost}} + 现金费用 {{kpi.cash_cost}} + 摊销 {{kpi.amort}} + 设备摊销 {{kpi.dep}} + 预提利息 {{kpi.accrue_int}}）</text></view>
      <view class="kpi-row"><text>费用率（成本/接单）</text><text class="kpi-n {{kpi.expense_ratio>=100?'bad':''}}">{{kpi.expense_ratio}}%</text></view>
      <view class="kpi-row" wx:if="{{kpi.break_even>0}}"><text>保本月收入</text><text class="kpi-n">约 {{kpi.break_even}} 元（低于这个数就亏）</text></view>
      <view class="kpi-row"><text>净资产</text><text class="kpi-n {{kpi.net_worth<0?'bad':'ok'}}">{{kpi.net_worth}} 元</text></view>
      <view class="kpi-sub">近 6 个月净利趋势</view>
      <view class="bar-line" wx:for="{{kpi.trend}}" wx:key="m">
        <view class="bar-m">{{item.m}}</view>
        <view class="bar-zone">
          <view class="bar bar-in" style="width:{{item.margin>0?item.margin:0}}%"></view>
          <text class="bar-num">{{item.profit}}（{{item.margin}}%）</text>
        </view>
      </view>
      <view class="tip">本月赚的 = 本月实际收到的钱 − 实际付出去的钱（收付实现制，和首页、报表页同一个数）。净利率 = 本月赚的 ÷ 本月收款。另一套「按单子算」的权责净利 = 接单 − 材料·外协 − 现金费用 − 摊销 − 设备摊销 − 预提利息，两者差多少就是赊出去还没收回来的钱。现金能撑几个月 = 手头现金 / 近 3 月平均月支出。</view>
    </view>

