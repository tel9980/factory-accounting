        <view class="kpi-row"><text>毛利</text><text class="kpi-n {{mb.profit>=0?'ok':'bad'}}">{{mb.profit}} 元 · 毛利率 {{mb.margin_pct}}%</text></view>
        <view class="duesoon" wx:if="{{mb.missing_cost>0}}">{{mb.hint}}</view>
        <view class="list">
          <view class="item" wx:for="{{mb.list}}" wx:key="name">
            <view class="row1"><text class="nm">{{item.name}}</text><text class="amt {{item.profit<0?'red':''}}">{{item.profit}}</text></view>
