      <view class="chips">
        <text class="chip-label">排序：</text>
        <text class="chip {{ap_sort==item.k?'on':''}}" wx:for="{{ar_sorts}}" wx:key="k" bindtap="pickApSort" data-k="{{item.k}}">{{item.n}}</text>
      </view>
      <view class="chips">
        <text class="chip-label">视图：</text>
        <text class="chip {{ap_view=='order'?'on':''}}" bindtap="pickApView" data-v="order">按单据</text>
        <text class="chip {{ap_view=='party'?'on':''}}" bindtap="pickApView" data-v="party">按供应商</text>
      </view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="openCollect" data-type="ap">💸 要付清单（该安排付款了）</button>
      </view>
      <view class="prev" wx:if="{{collect}}">
        <view class="prev-h">【{{collect.type_text}}清单】{{collect.count}} 家 · 合计 {{collect.total}} 元（按「欠得久 × 欠得多」排）</view>
        <view class="prev-row" wx:for="{{collect.list}}" wx:key="party" data-i="{{index}}" bindtap="copyCollectOne">
          <text class="prev-t">{{item.no}}. {{item.party}}</text>
          <text class="prev-n">欠 {{item.left}} · {{item.why}}</text>
          <text class="prev-n {{item.told_days!==null && item.told_days<=3 ? 'red':''}}">{{item.told_text}}</text>
          <text class="red" catchtap="recordDunning" data-party="{{item.party}}" data-type="{{collect.type}}">记一笔催款</text>
        </view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyCollectAll">📋 全部复制</button>
          <button class="btn ghost" size="mini" bindtap="makeCollectImage">🖼 存成图片发微信</button>
          <button class="btn ghost" size="mini" bindtap="openDunLog" data-type="{{collect.type}}">📋 催款台账</button>
          <button class="btn ghost" size="mini" bindtap="closeCollect">收起</button>
        </view>
        <view class="prev" wx:if="{{dun_log}}">
          <view class="prev-h">催款台账{{dun_log.type=='ap' ? '（应付）' : '（应收）'}}　共 {{dun_log.count}} 条　本月 {{dun_log.month_count}} 条{{dun_log.broken_count>0 ? '　失约 ' + dun_log.broken_count + ' 次' : ''}}</view>
          <view class="prev-row" wx:for="{{dun_log.rows}}" wx:key="id">
            <text class="prev-t">{{item.date}} · {{item.party}}</text>
            <text class="prev-n">{{item.note || '已催'}}{{item.promise_date ? '　答应 ' + item.promise_date + ' 付' : ''}}{{item.pstate_text ? '（' + item.pstate_text + '）' : ''}}</text>
            <text class="red" catchtap="delDunLog" data-id="{{item.id}}">删</text>
          </view>
          <view class="frow"><button class="btn ghost" size="mini" bindtap="closeDunLog">收起台账</button></view>
          <view class="tip">催完一家马上记一笔，系统记得「催过几次、上次哪天、答应哪天付」；答应的日子过了还没付，首页会单独提醒。</view>
        </view>
        <view class="tip">点某一家 = 只复制那家的话；「存成图片」= 生成一张提醒卡，微信里可以直接转发给对方。</view>
      </view>

      <view class="frow">
        <button class="btn ghost" size="mini" bindtap="openDue" data-type="ap">📅 到期表</button>
        <button class="btn ghost" size="mini" bindtap="openRisk" data-type="ap">⚠️ 超期分级</button>
      </view>

      <view class="prev" wx:if="{{due && due.type=='ap'}}">
        <view class="prev-h">到期表　未结 {{due.count}} 张 · 合计 {{due.total}} 元</view>
        <view class="prev-row red"><text class="prev-t">已逾期 {{due.overdue_total}} 元</text><text class="prev-n">7 天内到期 {{due.soon_total}} 元</text><text>没到期日 {{due.no_due_total}} 元</text></view>
        <view class="prev-row" wx:for="{{due.rows}}" wx:key="id">
          <text class="prev-t">{{item.party}}  {{item.left}}</text>
          <text class="prev-n">{{item.due || '没到期日'}}{{item.guess ? '(按账期)' : ''}}</text>
          <text class="{{item.days>0?'red':'ok'}}">{{item.state}}</text>
        </view>
        <view class="tip" wx:if="{{due.more}}">后面还有 {{due.more}} 张，导出 Excel 能看全。</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="downloadDueXlsx">⬇ 导出 Excel（发客户对账）</button>
          <button class="btn ghost" size="mini" bindtap="closeDue">收起</button>
        </view>
      </view>

      <view class="prev" wx:if="{{risk && risk.type=='ap'}}">
        <view class="prev-h">超期分级　{{risk.level}}</view>
        <view class="prev-row" wx:for="{{risk.b}}" wx:key="label">
          <text class="prev-t">{{item.label}}</text>
          <text class="prev-n">{{item.cnt}} 笔</text>
          <text class="{{item.label.indexOf('90')>=0?'red':'ok'}}">{{item.amount}} 元</text>
        </view>
        <view class="prev-row red" wx:if="{{risk.bad_count}}">拖最久的 {{risk.bad_count}} 家：{{risk.bad[0].party}} {{risk.bad[0].left}} 元（{{risk.bad[0].worst}} 天）</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyRiskText">📋 复制这份分级</button>
          <button class="btn ghost" size="mini" bindtap="closeRisk">收起</button>
        </view>
        <view class="tip">超过 90 天的那一档单独列出来——这就是该考虑催到底、还是核销坏账的小名单。</view>
      </view>
    </view>
    <view class="list" wx:if="{{ap_view=='party'}}">
      <view class="grp" wx:for="{{ap_groups}}" wx:key="name">
        <view class="grp-h" bindtap="toggleGroupAp" data-n="{{item.name}}">
          <view class="row1"><text class="nm">{{item.name}}</text><text class="amt">{{ap_open==item.name?'收起':'欠'+item.unpaid}}</text></view>
          <view class="row2">{{item.cnt}} 笔 · 欠款合计 {{item.unpaid}} · 最久 {{item.oldest_days}} 天{{item.overdue>0?' · 超30天'+item.overdue+'笔':''}}{{item.due_soon>0?' · 7天内要付'+item.due_soon+'笔':''}}</view>
        </view>
        <view class="grp-b" wx:if="{{ap_open==item.name}}">
          <view class="gitem" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="row1"><text class="nm">{{it.title}}</text><text class="amt">欠{{it.unpaid}}</text></view>
            <view class="row2">总{{it.total}} · 已付{{it.paid}}{{it.written_off>0?' · 核销'+it.written_off:''}} · 已欠{{it.days}}天{{it.due_short?' · 约定'+it.due_short:''}}</view>
            <view class="btns">
              <button size="mini" bindtap="payAll" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">付清</button>
              <button size="mini" bindtap="payPayable" data-id="{{it.id}}">付款</button>
              <button size="mini" bindtap="showDetail" data-id="{{it.id}}" data-type="ap">明细</button>
              <button size="mini" bindtap="openReceipt" data-id="{{it.id}}" data-type="ap">收据</button>
              <button size="mini" bindtap="editDue" data-id="{{it.id}}" data-type="ap" data-due="{{it.due_short}}">改期</button>
              <button size="mini" bindtap="writeoffPayable" data-id="{{it.id}}" data-unpaid="{{it.unpaid}}">核销</button>
            </view>
          </view>
          <view class="tip" wx:if="{{item.items_more}}">列表最多 100 笔（先早后晚），要全的可以看对账单</view>
          <view class="row2" wx:if="{{!item.items.length}}">正在取这家单据…</view>
          <view class="btns">
            <button size="mini" bindtap="groupPay" data-n="{{item.name}}" data-amt="{{item.unpaid}}">整户付款</button>
            <button size="mini" bindtap="statement" data-type="ap" data-name="{{item.name}}">对账单</button>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!ap_groups.length}}">按{{ap_filter=='overdue'?'超30天':'未结'}}没有供应商欠款</view>
    </view>
    <view class="list" wx:if="{{ap_view=='order'}}">
      <view class="item" wx:for="{{ap_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.supplier}}</text><text class="amt">欠{{item.unpaid}}</text></view>
        <view class="row2">总{{item.amount}} · 已付{{item.paid}}{{item.written_off>0?' · 核销'+item.written_off:''}} · 已欠{{item.days}}天{{item.due_short?' · 约定'+item.due_short:''}}{{item.remark ? ' · ' + item.remark : ''}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="btns">
          <button size="mini" bindtap="payAll" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}" wx:if="{{!item.settled}}">付清</button>
          <button size="mini" bindtap="showDetail" data-id="{{item.id}}" data-type="ap">明细</button>
          <button size="mini" bindtap="openReceipt" data-id="{{item.id}}" data-type="ap">收据</button>
          <button size="mini" bindtap="editDue" data-id="{{item.id}}" data-type="ap" data-due="{{item.due_short}}">改期</button>
          <button size="mini" bindtap="payPayable" data-id="{{item.id}}">付款</button>
          <button size="mini" bindtap="applyAdvancePayable" data-id="{{item.id}}">预付抵</button>
          <button size="mini" bindtap="writeoffPayable" data-id="{{item.id}}" data-unpaid="{{item.unpaid}}">核销</button>
          <button size="mini" bindtap="againPayable" data-id="{{item.id}}">再来一笔</button>
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="editPayable" data-id="{{item.id}}">改</button>
          <button size="mini" wx:if="{{role=='staff'}}" bindtap="openEditReq" data-kind="ap" data-id="{{item.id}}">申请改</button>
          <button size="mini" bindtap="statement" data-type="ap" data-name="{{item.supplier}}">对账</button>
          <button size="mini" bindtap="monthStatement" data-type="ap" data-name="{{item.supplier}}">月结</button>
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="delPayable" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!ap_list.length}}">{{ap_filter=='closed'?'没有已结清的应付':'没有未结清的应付'}}</view>
      <view class="loadmore" wx:if="{{ap_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ap_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

  <block wx:if="{{tab=='expense'}}">
    <view class="form">
      <picker range="{{categories}}" bindchange="onECategory"><view class="picker">分类：{{categories[e_category]}} ▾</view></picker>
      <picker range="{{acc_names}}" bindchange="onEAcc"><view class="picker">付自：{{acc_names[e_acc] || '现金'}} ▾</view></picker>
      <view class="chips" wx:if="{{sug_ex.length}}">
        <text class="chip-label">常记：</text>
        <text class="chip" wx:for="{{sug_ex}}" wx:key="index" bindtap="fillSug" data-t="ex" data-i="{{index}}">{{item.party}} {{item.amount}}</text>
      </view>
      <input class="inp" placeholder="金额(元)" type="digit" value="{{e_amount}}" bindinput="onEAmount"/>
<view class="amts"><view class="amt" wx:for="{{amts}}" wx:key="*this" bindtap="fillAmt" data-f="e_amount" data-v="{{item}}">{{item}}</view></view>
<view class="amts"><view class="amt" wx:for="{{amts}}" wx:key="*this" bindtap="fillAmt" data-f="e_amount" data-v="{{item}}">{{item}}</view></view>
      <input class="inp" placeholder="备注(可选)" value="{{e_remark}}" bindinput="onERemark"/>
      <input class="inp" placeholder="经手人(可选)" value="{{e_operator}}" bindinput="onEOperator"/>
      <view class="dateRow">
        <picker mode="date" data-f="e_date" bindchange="onDatePick" class="datePick">
          <view class="dateInp">{{e_date || '日期（默认今天）'}}</view>
        </picker>
        <text class="dateClr" wx:if="{{e_date}}" data-f="e_date" bindtap="clearDate">今天</text>
      </view>
      <button class="btn" size="mini" bindtap="addExpense">记支出</button>
    </view>

    <view class="form">
      <view class="tip">员工借支 / 报销（借出先记账不冲成本，报销时按分类记支出，冲借支不动现金）<text wx:if="{{loan_open}}"> · 未清 ¥{{loan_open}}</text></view>
      <input class="inp" placeholder="员工姓名" value="{{l_staff}}" bindinput="onLStaff"/>
      <input class="inp" placeholder="借出金额(元)" type="digit" value="{{l_amount}}" bindinput="onLAmount"/>
      <input class="inp" placeholder="用途备注(可选)" value="{{l_remark}}" bindinput="onLRemark"/>
      <button class="btn" size="mini" bindtap="addLoan">借出</button>

      <view class="reimb" wx:if="{{cur_loan}}">
        <view class="tip">正在报销：{{cur_loan_name}}</view>
        <picker range="{{categories}}" bindchange="onRlCategory"><view class="picker">分类：{{categories[rl_category] || '其他'}} ▾</view></picker>
        <input class="inp" placeholder="报销金额(默认全部结清)" type="digit" value="{{rl_amount}}" bindinput="onRlAmount"/>
        <input class="inp" placeholder="备注(可选)" value="{{rl_remark}}" bindinput="onRlRemark"/>
        <view class="btns">
          <button size="mini" bindtap="doReimburse">确认报销</button>
          <button size="mini" bindtap="cancelReimburse">取消</button>
        </view>
      </view>

      <view class="list">
        <view class="item" wx:for="{{loans}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.staff}}</text><text class="amt out">借 {{item.amount}}</text></view>
          <view class="row2">已报 {{item.used}} · 退回 {{item.returned}} · 未清 {{item.remain}}{{item.remark?' · '+item.remark:''}}</view>
          <view class="btns">
            <button size="mini" wx:if="{{item.remain>0}}" bindtap="startReimburse" data-id="{{item.id}}" data-name="{{item.staff}}" data-remain="{{item.remain}}">报销</button>
            <button size="mini" wx:if="{{item.remain>0}}" bindtap="returnLoan" data-id="{{item.id}}" data-remain="{{item.remain}}">退回余款</button>
            <button size="mini" wx:if="{{item.used==0 && item.returned==0}}" bindtap="delLoan" data-id="{{item.id}}">删</button>
          </view>
        </view>
        <view class="empty" wx:if="{{!loans.length}}">还没有员工借支</view>
      </view>
    </view>
    <view class="form">
      <input class="inp" placeholder="搜索分类/备注" value="{{ex_kw}}" bindinput="onExKw"/>
    </view>
    <view class="list">
      <view class="item" wx:for="{{expense_list}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.category}}</text><text class="amt out">{{item.amount}}</text></view>
        <view class="row2">{{item.remark}} · {{item.created_at}}{{item.operator?' · '+item.operator:''}}</view>
        <view class="btns">
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="editExpense" data-id="{{item.id}}">改</button>
          <button size="mini" wx:if="{{role=='staff'}}" bindtap="openEditReq" data-kind="expense" data-id="{{item.id}}">申请改</button>
          <button size="mini" wx:if="{{role!='staff'}}" bindtap="delExpense" data-id="{{item.id}}">删</button>
        </view>
      </view>
      <view class="empty" wx:if="{{!expense_list.length}}">暂无支出记录</view>
      <view class="loadmore" wx:if="{{ex_more}}"><button class="btn" size="mini" bindtap="loadMoreTap">加载更早的</button></view>
      <view class="tip" wx:if="{{ex_more}}">只显示了最近一部分，上拉或点按钮继续加载</view>
    </view>
  </block>

  <block wx:if="{{tab=='import'}}">
    <view class="form">
      <picker range="{{import_types}}" bindchange="onImportType"><view class="picker">{{import_types[import_type]}} ▾</view></picker>
      <button class="btn" size="mini" bindtap="excelTemplate">⬇ 下载 Excel 模板（.xlsx，推荐）</button>
      <button class="btn" size="mini" bindtap="chooseXlsxFile">📊 选 Excel 文件直接导入</button>
      <button class="btn ghost" size="mini" bindtap="exportTemplate">⬇ 老办法：导出 CSV 模板</button>
      <button class="btn btn-ghost" size="mini" bindtap="chooseImportFile">📄 选 CSV/TXT 文件导入</button>
      <view class="tip" wx:if="{{import_file_name}}">已读入：{{import_file_name}}</view>
      <textarea class="ta" placeholder="{{import_hint}}" value="{{import_text}}" bindinput="onImportText"></textarea>
      <button class="btn" size="mini" bindtap="doImport">① 先看预览（确认后再入账）</button>
      <button class="btn" size="mini" bindtap="excelTemplate" data-t="recon">⬇ 下载对账模板（单位 / 金额 两列）</button>
      <button class="btn" size="mini" bindtap="chooseReconFile">📊 选对账表格直接核对</button>
      <button class="btn ghost" size="mini" bindtap="doReconcile">🔍 对账核对（和系统里的数比一比）</button>

      <view class="prev" wx:if="{{import_preview}}">
        <view class="prev-h">看清了再导：{{import_preview.count}} 条，合计 {{import_preview.total}} 元</view>
        <view class="tip" wx:if="{{import_preview.cost_total>0}}">其中成本 {{import_preview.cost_total}} 元，预计毛利 {{import_preview.profit}} 元</view>
        <view class="prev-row" wx:for="{{import_preview.rows}}" wx:key="line">
          <text class="prev-ok {{item.ok?'ok':'red'}}">{{item.ok ? '✓' : '✗'}}</text>
          <text class="prev-t">{{item.party}}{{item.item ? ' · ' + item.item : ''}}{{item.date ? ' · ' + item.date : ''}}</text>
          <text class="prev-n">{{item.ok ? item.amount : item.error}}</text>
        </view>
        <view class="tip" wx:if="{{import_preview.new_text}}">新单位（系统里还没有）：{{import_preview.new_text}}</view>
        <view class="tip" wx:if="{{import_preview.bad_count}}">有 {{import_preview.bad_count}} 行没看懂，这些不会导入</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="confirmImport">确认入账 {{import_preview.count}} 条</button>
          <button class="btn ghost" size="mini" bindtap="cancelPreview">取消</button>
        </view>
      </view>

      <view class="prev" wx:if="{{recon}}">
        <view class="prev-h">对账结果：{{recon.count}} 家　一致 {{recon.match_count}}　有差异 {{recon.diff_count}}</view>
        <view class="prev-row" wx:for="{{recon.rows}}" wx:key="party">
          <text class="prev-t">{{item.party}}</text>
          <text class="prev-n">单上 {{item.imported}} / 我这 {{item.system}}</text>
          <text class="{{item.bad?'red':'ok'}}">{{item.state_text}}</text>
          <view class="frow" wx:if="{{item.state!='match'}}">
            <button class="btn" size="mini" wx:if="{{item.state=='more'||item.state=='new'}}" data-i="{{index}}" bindtap="reconFixAdd">＋ 补记这笔</button>
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="reconFixIgnore">✓ 不用补，标记处理完</button>
          </view>
        </view>
        <view class="tip">「我少记」= 客户的数比系统里大，可能漏单或漏记收款；「我多记」= 系统里偏大，可能记重了或对方已付没记。</view>
        <view class="tip">核对完可以直接改单，不用重复导入。</view>
        <view class="frow">
          <button class="btn" size="mini" wx:if="{{recon.add_count>0}}" bindtap="reconFixAll">＋ 差异全部补记（{{recon.add_count}} 家）</button>
          <button class="btn" size="mini" bindtap="saveRecon">📌 记进对账台账</button>
          <button class="btn ghost" size="mini" bindtap="copyDiffText">📋 复制差异清单</button>
          <button class="btn ghost" size="mini" bindtap="loadReconLog">看已记的台账</button>
        </view>
      </view>

      <view class="prev" wx:if="{{recon_log}}">
        <view class="prev-h">对账台账　{{recon_log.rows.length}} 条　还差 {{recon_log.open_diff}} 条没处理</view>
        <view class="prev-row" wx:for="{{recon_log.rows}}" wx:key="id" data-i="{{index}}" bindtap="toggleReconDone" bindlongpress="delReconLog">
          <text class="prev-t">{{item.month}} {{item.type=='ap'?'应付':'应收'}} · {{item.party}}</text>
          <text class="prev-n">单上 {{item.imported}} / 我这 {{item.system}}</text>
          <text class="{{item.bad?'red':'ok'}}">{{item.state_text}} · {{item.done_text}}</text>
        </view>
        <view class="tip">点一下 = 标记已处理／未处理；长按 = 删掉这条记录（不动单据）。每月对完一次，月底看「还差几家没处理」就知道有没有漏。</view>
      </view>

      <view class="frow">
        <button class="btn ghost" size="mini" bindtap="loadReconProgress">📈 对账进度</button>
        <button class="btn ghost" size="mini" bindtap="loadReconDunning">💬 差异话术</button>
      </view>

      <view class="prev" wx:if="{{rec_prog}}">
        <view class="prev-h">{{rec_prog.type_text}}对账进度　还没对过 {{rec_prog.never_count}} 家　差异没处理 {{rec_prog.open_diff}} 条</view>
        <view class="prev-row" wx:for="{{rec_prog.list}}" wx:key="party">
          <text class="prev-t">{{item.party}}</text>
          <text class="prev-n">{{item.last_month}} 账期 · 对过 {{item.times}} 次</text>
          <text class="{{item.bad?'red':'ok'}}">{{item.state_text}}</text>
        </view>
        <view class="tip" wx:if="{{rec_prog.never_count}}">有欠款但还没对过账：{{rec_prog.never[0].party}} {{rec_prog.never[0].left}} 元{{rec_prog.never_count>1 ? ' 等 ' + rec_prog.never_count + ' 家' : ''}}——这些最该先对。</view>
      </view>

      <view class="prev" wx:if="{{rec_dun}}">
        <view class="prev-h">差异话术　{{rec_dun.count}} 家要说</view>
        <view class="prev-row" wx:for="{{rec_dun.rows}}" wx:key="id" data-i="{{index}}" bindtap="copyDunOne">
          <text class="prev-t">{{item.party}}</text>
          <text class="prev-n">单上 {{item.imported}} / 我这 {{item.system}}</text>
          <text class="red">点我复制</text>
        </view>
        <view class="frow" wx:if="{{rec_dun.count}}">
          <button class="btn" size="mini" bindtap="copyDunAll">📋 全部复制</button>
        </view>
        <view class="tip">点某一家 = 复制专门给那家说的话（带上差额和原因），直接粘到微信发出去。</view>
      </view>

      <view class="prev" wx:if="{{import_log}}">
        <view class="prev-h">导入记录（最近 50 批，导错了能整批撤回）</view>
        <view class="prev-row" wx:for="{{import_log.rows}}" wx:key="id" data-i="{{index}}">
          <text class="prev-t">{{item.kind_text}} · {{item.cnt}} 条 · {{item.total}} 元{{item.dup_count ? ' · 跳重复 ' + item.dup_count : ''}}</text>
          <text class="prev-n">{{item.time_text}} · {{item.src_text}}</text>
          <view class="frow">
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="loadImportBatch">看这几笔</button>
          </view>
          <view class="frow" wx:if="{{!item.undone}}">
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="undoImport">撤回这批</button>
            <button class="btn ghost" size="mini" data-i="{{index}}" bindtap="delImportLog">删记录</button>
          </view>
          <text class="tip" wx:else>这批已撤回</text>
        </view>
        <view class="prev" wx:if="{{imp_docs}}">
          <view class="prev-t">这批 {{imp_docs.cnt}} 笔 · 共 ¥{{imp_docs.total}} · 还欠 ¥{{imp_docs.left_total}}</view>
          <view class="prev-n">{{imp_docs.at_text}}{{imp_docs.found}} 笔还在{{imp_docs.missing ? '，' + imp_docs.missing + ' 笔已被删' : ''}}{{imp_docs.paid_count ? '，' + imp_docs.paid_count + ' 笔已结清' : ''}}</view>
          <view class="prev-row" wx:for="{{imp_docs.rows}}" wx:key="id">
            <text class="prev-t">{{item.party}} · {{item.kind_text}} · ¥{{item.amount}}</text>
            <text class="prev-n">{{item.date}}{{item.status ? ' · ' + item.status : ''}}{{item.done ? ' · 已结清' : ' · 还欠 ¥' + item.left}}</text>
          </view>
          <button class="btn ghost" size="mini" bindtap="closeImpDocs">收起</button>
        </view>
        <view class="tip">撤回只删「这一批」导入的单据；已经收过款、付过款或所在月份已结账的不会删，会告诉你几条没撤。</view>
      </view>
      <view class="tip">最省事的两步：① 点「下载 Excel 模板」→ 转发到电脑，用 Excel/WPS 填几行（表头别删，日期可留空）→ 微信发回给自己；② 回到这里点「选 Excel 文件直接导入」。Excel 存什么编码都能读，不用另存 CSV。也可以直接从 Excel 复制多行粘到上面的框里。</view>
    </view>
  </block>

  <block wx:if="{{tab=='report'}}">
    <view class="form">
      <view class="tip">手机看报表（不用开 Excel）　月份如 2026-11，不填=本月</view>
      <input class="inp" placeholder="月份，如 2026-11（不填=本月）" value="{{rv_month}}" bindinput="onRvMonth"/>
      <view class="frow">
        <button class="btn" size="mini" bindtap="loadReportView">看这个月</button>
        <button class="btn ghost" size="mini" bindtap="loadAnomaly">🔎 异常提醒</button>
      </view>
      <view wx:if="{{rv}}">
        <view class="prev-h">利润表　{{rv.month}}</view>
        <view class="plrow" wx:for="{{rv.pl}}" wx:key="label">
          <text class="{{item.strong?'pll strong':'pll'}}">{{item.label}}</text>
          <text class="{{item.value>=0?'plv ok':'plv bad'}}">{{item.value}}</text>
        </view>
        <view class="prev-h">家底　资产 {{rv.bs.assets[rv.bs.assets.length-1].value}} 元</view>
        <view class="plrow" wx:for="{{rv.bs.assets}}" wx:key="label">
          <text class="{{item.strong?'pll strong':'pll'}}">{{item.label}}</text>
          <text class="plv">{{item.value}}</text>
        </view>
        <view class="plrow" wx:for="{{rv.bs.liabilities}}" wx:key="label">
          <text class="{{item.strong?'pll strong':'pll'}}">{{item.label}}</text>
          <text class="plv">{{item.value}}</text>
        </view>
        <view class="plrow">
          <text class="pll strong">所有者权益</text>
          <text class="plv ok">{{rv.bs.equity}}</text>
        </view>
        <view class="tip">平衡校验差额 {{rv.bs.check}}（0 = 账是平的）　本月现金：收 {{rv.cash.inc}} − 付 {{rv.cash.out}} = {{rv.cash.net}}</view>
        <view class="tip">钱花在哪：<text wx:for="{{rv.cats}}" wx:key="name">{{item.name}} {{item.amount}}　</text></view>
        <view class="aline {{item.tone}}" wx:for="{{rv.tips}}" wx:key="text">{{item.text}}</view>
      </view>
      <view wx:if="{{ano}}">
        <view class="prev-h">异常提醒　{{ano.count}} 条（{{ano.month}}）</view>
        <view class="tip" wx:if="{{!ano.count}}">没发现异常：费用没冒尖、欠款没突变、成本都填了。</view>
        <view class="aline {{item.tone}}" wx:for="{{ano.list}}" wx:key="text">{{item.text}}</view>
      </view>
    </view>
    <view class="form">
      <view class="tip">经营趋势：最近几个月净利一眼看</view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="loadTrend">📈 看最近 6 个月</button>
        <button class="btn ghost" size="mini" bindtap="loadPaySpeed">🐢 谁付钱最慢</button>
        <button class="btn ghost" size="mini" bindtap="loadTargetHistory">🎯 目标完成情况</button>
      </view>
      <view wx:if="{{th}}">
        <view class="prev-h">目标完成　过完的 {{th.months}} 个月里设过 {{th.target_months}} 次目标，达成 {{th.hit_months}} 次</view>
        <view class="plrow" wx:for="{{th.rows}}" wx:key="month">
          <text class="pll">{{item.label}}</text>
          <text class="plv">{{item.receive}}{{item.receive_target>0 ? ' / '+item.receive_target : ''}}</text>
          <text class="{{item.hit===true?'ok':(item.hit===false?'bad':'')}}" style="width:120rpx;text-align:right">{{item.receive_target>0 ? (item.receive_pct+'%') : '没设'}}</text>
        </view>
        <view class="aline {{item.tone}}" wx:for="{{thTips}}" wx:key="text">{{item.text}}</view>
        <view class="frow">
          <button class="btn ghost" size="mini" bindtap="loadTargetWeeks">📅 拆到每周</button>
          <button class="btn ghost" size="mini" bindtap="loadTargetForecast">🔮 这月能完成吗</button>
        </view>
        <view wx:if="{{tw}}">
          <view class="prev-h">每周该收多少　合计实收 {{tw.total_actual}} / 目标 {{tw.receive_target}}</view>
          <view class="plrow" wx:for="{{tw.rows}}" wx:key="w">
            <text class="pll">{{item.label}} {{item.from}}</text>
            <text class="plv">{{item.actual}} / {{item.target}}</text>
            <text class="{{item.pct>=100?'ok':(item.state=='已过完'?'bad':'')}}" style="width:110rpx;text-align:right">{{item.pct}}%</text>
          </view>
          <view class="aline warn">{{tw.advice}}</view>
        </view>
        <view wx:if="{{tf}}">
          <view class="prev-h">这月能完成吗</view>
          <view class="plrow"><text class="pll">已经收到</text><text class="plv ok">{{tf.received}}</text></view>
          <view class="plrow"><text class="pll">本月内到期还没收（{{tf.open_count}} 单）</text><text class="plv">{{tf.open_amount}}</text></view>
          <view class="plrow"><text class="pll">按回款率 {{tf.rate}}% 预计还能收</text><text class="plv">{{tf.expected_more}}</text></view>
          <view class="plrow"><text class="pll strong">月底预计合计</text><text class="plv {{tf.will_hit?'ok':'bad'}}">{{tf.expected_total}} / 目标 {{tf.receive_target}}</text></view>
          <view class="aline {{tf.will_hit?'ok':'bad'}}">{{tf.note}}</view>
        </view>
        <view wx:if="{{th.suggest && th.suggest.receive>0}}" class="frow">
          <button class="btn" size="mini" bindtap="applySuggest">✨ 下月就按 {{th.suggest.receive}} 设</button>
        </view>
        <view class="tip" wx:if="{{th.suggest && th.suggest.basis}}">建议依据：{{th.suggest.basis}}</view>
        <view class="tip">左=实际收到，右=当月目标；百分比是达成率。本月还没过完，只显示进度不算达成。</view>
      </view>
      <view wx:if="{{trend}}">
        <view class="prev-h">每月净利（红=亏）　合计 {{trend.total}}　月均 {{trend.avg}}</view>
        <view class="trow" wx:for="{{trend.months}}" wx:key="m">
          <text class="tlabel">{{item.label}}</text>
          <view class="tbar"><view class="{{item.neg?'tbar-in bad':'tbar-in'}}" style="width:{{item.bar_w}}%"></view></view>
          <text class="tval {{item.neg?'red':'green'}}">{{item.profit}}</text>
        </view>
        <view class="aline {{item.tone}}" wx:for="{{trend.advice}}" wx:key="text">{{item.text}}</view>
      </view>
      <view wx:if="{{ps}}">
        <view class="prev-h">回款速度　平均 {{ps.avg_days}} 天（只算已结清的）</view>
        <view class="prev-row" wx:for="{{ps.fast}}" wx:key="party">
          <text class="prev-t">✔ {{item.party}}</text>
          <text class="prev-n">平均 {{item.avg_days}} 天 · 已结 {{item.done_amt}} 元</text>
        </view>
        <view class="prev-row" wx:for="{{ps.slow}}" wx:key="party">
          <text class="prev-t">🐢 {{item.party}}</text>
          <text class="prev-n">平均 {{item.avg_days}} 天 · 还欠 {{item.unpaid_amt}}</text>
        </view>
        <view class="prev-row" wx:for="{{ps.never}}" wx:key="party">
          <text class="prev-t">✖ {{item.party}}</text>
          <text class="prev-n">一笔没结清 · 欠 {{item.unpaid_amt}} · 等了 {{item.wait_days}} 天</text>
        </view>
        <view class="aline {{item.tone}}" wx:for="{{ps.advice}}" wx:key="text">{{item.text}}</view>
      </view>
    </view>
    <view class="form">
      <view class="tip">保本线：这个月最少要收多少才不亏（固定开销 ＋ 变动成本率）</view>
      <button class="btn" size="mini" bindtap="loadBreakEven">⚖ 算保本线</button>
      <view wx:if="{{be}}">
        <view class="tip">{{be.note}}</view>
        <view class="plrow"><text class="pll">每月固定开销（近3个月平均）</text><text class="plv">{{be.fixed_avg}}</text></view>
        <view class="plrow"><text class="pll">变动成本占比（采购辅料运费 / 接单）</text><text class="plv">{{be.var_ratio}}%</text></view>
        <view class="plrow"><text class="pll strong">保本月收入</text><text class="plv {{be.gap>0?'bad':'ok'}}">{{be.break_even}}</text></view>
        <view class="plrow"><text class="pll">本月接单 / 本月现金支出</text><text class="plv">{{be.month_order_add}} / {{be.month_out}}</text></view>
        <view class="plrow" wx:for="{{be.items}}" wx:key="name">
          <text class="pll">{{item.name}}（{{item.kind}}）</text>
          <text class="plv">{{item.amount}}</text>
        </view>
        <view class="tip">固定 = 房租工资水电这类不管接单多少都要花的；变动 = 采购辅料运费，接单越多花越多。固定 ÷（1 − 变动占比）= 保本线。</view>
      </view>
    </view>
    <view class="form">
      <view class="tip">催款效果：催了几次、催完到底有没有把钱催回来</view>
      <button class="btn" size="mini" bindtap="loadDunEffect">📣 看催款效果</button>
      <view wx:if="{{dfx}}">
        <view class="tip">{{dfx.months}} 个月内催过 {{dfx.count}} 家 / 共 {{dfx.total_dun}} 次；催后收回 ¥{{dfx.recovered}}，平均一次催回 ¥{{dfx.avg_per_dun}}；这些家现在还欠 ¥{{dfx.still_left}}</view>
        <view class="aline {{item.tone}}" wx:for="{{dfx.advice}}" wx:key="text">{{item.text}}</view>
        <view class="prev-row" wx:for="{{dfx.rows}}" wx:key="party">
          <text class="prev-t">{{index+1}}. {{item.party}}（{{item.type_text}}）</text>
          <text class="prev-n">催 {{item.times}} 次 · 催后收回 {{item.paid_after}} · 还欠 {{item.left}} · 最后一次 {{item.last}}（{{item.last_days}} 天前）</text>
          <text class="prev-n {{item.verdict==='quiet'?'red':''}}">{{item.text}}</text>
        </view>
        <view class="frow"><button class="btn ghost" size="mini" bindtap="copyDunEffect">📋 复制成文字</button></view>
      </view>
    </view>
    <view class="form">
      <view class="tip">月度催款小结：这个月催了几家、催回多少、谁还欠着（可复制发微信 / 存图）</view>
      <button class="btn" size="mini" bindtap="loadDunMonth">📣 出本月催款小结</button>
      <view class="tip">年度催款汇总：12 个月催了几次、催回多少、失约几次、发单几份（看全年催款效率）</view>
      <view class="frow">
        <input class="in" type="number" placeholder="年（默认今年）" value="{{dy_year}}" bindinput="onDyYear" />
        <button class="btn" size="mini" bindtap="loadDunYear">📅 看年度汇总</button>
      </view>
      <view wx:if="{{dy}}">
        <view class="prev-h">{{dy.year}} 年 · 催 {{dy.total.times}} 次 · 催后收回 ¥{{dy.total.recovered}} · 平均一次 ¥{{dy.total.avg}} · 失约 {{dy.total.broken}} 次</view>
        <view class="prev-row" wx:for="{{dy.rows}}" wx:key="m">
          <text class="k">{{item.label}}</text>
          <text class="v">{{item.times ? '催 ' + item.times + ' 次 · 收回 ¥' + item.recovered : '—'}}{{item.broken ? ' · 失约 ' + item.broken : ''}}{{item.disputes ? ' · 争议 ' + item.disputes : ''}}</text>
        </view>
        <view class="tip">发对账单 {{dy.total.statements}} 份 · 对方有异议 {{dy.total.disputes}} 份</view>
        <view class="line" wx:for="{{dy.advice}}" wx:key="text" class="{{item.tone==='warn'?'warn':'ok'}}">{{item.text}}</view>
        <view class="frow">
          <button class="btn ghost" size="mini" bindtap="copyDunYear">复制</button>
          <button class="btn ghost" size="mini" bindtap="closeDunYear">收起</button>
        </view>
      </view>
      <view wx:if="{{dsum}}">
        <view class="prev-h">{{dsum.month}} · 催 {{dsum.times}} 次 / {{dsum.count}} 家 · 催后收回 ¥{{dsum.recovered}} · 还欠 ¥{{dsum.left_total}}</view>
        <view class="prev-row" wx:for="{{dsum.still}}" wx:key="party">
          <text class="prev-t">{{item.party}}</text>
          <text class="prev-n">欠 {{item.left}} · 催 {{item.times}} 次{{item.broken ? ' · 失约 ' + item.broken + ' 次' : ''}}</text>
        </view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyDunMonth">📋 复制文字</button>
          <button class="btn ghost" size="mini" bindtap="makeDunMonthImage">🖼 存成图片</button>
        </view>
        <view class="tip">{{dsum_text}}</view>
      </view>
    </view>
    <view class="form">
      <view class="tip">对账单争议：对方说对不上的，专门一页处理（拖久了容易变死账）</view>
      <view class="tip">月度对账小结：这个月和谁对过、差多少、补了几笔、还有谁没对，一页说清</view>
      <view class="frow">
        <button class="btn" size="mini" bindtap="loadReconMonth">📋 出本月对账小结</button>
      </view>
      <view wx:if="{{rsum}}">
        <view class="prev-h">{{rsum.month}} · {{rsum.type_text}} · 对过 {{rsum.reconciled}} 家（一致 {{rsum.match}} / 有差异 {{rsum.diff}}）</view>
        <view class="aline {{rsum.never_count ? 'warn' : 'ok'}}">{{rsum.advice}}</view>
        <view class="tip">补记 {{rsum.fixed_count}} 笔 ¥{{rsum.fixed_amount}}{{rsum.open_diff ? ' · 未处理 ' + rsum.open_diff + ' 家' : ''}}{{rsum.never_count ? ' · 没对过 ' + rsum.never_count + ' 家（欠 ¥' + rsum.never_left + '）' : ''}}</view>
        <view class="frow">
          <button class="btn" size="mini" bindtap="copyReconMonth">📋 复制文字</button>
          <button class="btn ghost" size="mini" bindtap="makeReconMonthImage">🖼 存成图片</button>
          <button class="btn ghost" size="mini" bindtap="closeReconMonth">收起</button>
        </view>
        <view class="tip">{{rsum_text}}</view>
      </view>
      <button class="btn" size="mini" bindtap="loadDisputes">⚠ 看争议清单</button>
      <view wx:if="{{dp}}">
        <view class="tip">{{dp.count}} 份待处理，涉及欠款 ¥{{dp.total_left}}{{dp.oldest_days ? '，最久的拖了 ' + dp.oldest_days + ' 天' : ''}}</view>
        <view class="aline {{dp.count ? 'warn':'ok'}}">{{dp.advice}}</view>
        <view class="item" wx:for="{{dp.rows}}" wx:key="id">
          <view class="row1"><text class="nm">{{item.party}}（{{item.kind_text}}）</text><text class="amt {{item.left>0?'red':'ok'}}">{{item.resolved ? '已处理' : '待处理'}}</text></view>
          <view class="row2">{{item.date}} 发的{{item.month ? ' ' + item.month + ' 月账单' : '对账单'}} · {{item.days}} 天前</view>
          <view class="row2">对方说：{{item.note || '对不上'}}</view>
          <view class="row2">现在欠 {{item.left}}（{{item.open_cnt}} 笔未结）· {{item.advice}}</view>
          <view class="btns" wx:if="{{!item.resolved}}">
            <button size="mini" bindtap="resolveDispute" data-id="{{item.id}}" data-k="fixed">✓ 核对完了</button>
            <button size="mini" bindtap="resolveDispute" data-id="{{item.id}}" data-k="ignore">不用管</button>
          </view>
          <view class="btns"><button size="mini" class="ghost" bindtap="openDisputeBook" data-party="{{item.party}}">🕘 处理过程 / 跟对方怎么说</button></view>
        </view>
      </view>
    </view>
    <view class="form" wx:if="{{dbk}}">
      <view class="tip">争议台账{{dbk.party_filter ? ' · ' + dbk.party_filter : ''}}（每笔从「对方说对不上」到「怎么收场」的一条线）</view>
      <view class="aline {{dbk.count ? 'warn':'ok'}}">{{dbk.advice}}</view>
      <view class="tip">共 {{dbk.total}} 笔 · 未结 {{dbk.count}} 笔{{dbk.fixed_total ? ' · 累计核实补记 ¥' + dbk.fixed_total : ''}}</view>
      <view class="item" wx:for="{{dbk.rows}}" wx:key="id">
        <view class="row1"><text class="nm">{{item.party}}（{{item.kind_text || (item.type=='ap'?'应付':'应收')}}）</text><text class="amt {{item.resolved?'ok':'red'}}">{{item.resolved?'已了结':'拖了 '+item.days_open+' 天'}}</text></view>
        <view class="row2">{{item.month}} 期对账单 · 现在欠 ¥{{item.left}}{{item.fixed_amount ? ' · 核实补记 ¥' + item.fixed_amount : ''}}</view>
        <view class="tl" wx:for="{{item.timeline}}" wx:for-item="t" wx:key="d">
          <text class="tl-d">{{t.d}}</text><text class="tl-t">{{t.t}}</text>
        </view>
        <view class="tip">发对账单时可以说：{{item.resend_text}}</view>
        <view class="btns"><button size="mini" bindtap="copyResend" data-text="{{item.resend_text}}">📋 复制这句话</button></view>
      </view>
      <view class="frow">
        <button class="btn ghost" size="mini" bindtap="loadDisputeBookAll">看全部（含已了结）</button>
        <button class="btn ghost" size="mini" bindtap="closeDisputeBook">收起</button>
      </view>
    </view>
    <view class="form">
      <view class="tip">年度总账：12 个月拼一张看全年</view>
      <input class="inp" placeholder="年份，如 2026（不填=今年）" value="{{ys_year}}" bindinput="onYsYear"/>
      <button class="btn" size="mini" bindtap="loadYearSummary">📅 出年度总账</button>
      <view wx:if="{{ys}}">
        <view class="tip">{{ys.year}} 年　接单 {{ys.total.order_add}}　毛利 {{ys.total.gross}}　费用 {{ys.total.expense}}　净利 {{ys.total.profit}}（{{ys.active_months}} 个月有账）</view>
        <view class="plrow" wx:for="{{ys.rows}}" wx:key="m">
          <text class="pll">{{item.month_label}}</text>
          <text class="plv {{item.neg?'bad':'ok'}}">{{item.profit}}</text>
          <view class="ybar"><view class="{{item.neg?'ybar-in bad':'ybar-in'}}" style="width:{{item.bar_w}}%"></view></view>
        </view>
        <view class="tip">最好 {{ys.best.month_label}} {{ys.best.profit}} 元　最差 {{ys.worst.month_label}} {{ys.worst.profit}} 元　月均 {{ys.avg_profit}} 元</view>
      </view>
    </view>
    <view class="form">
      <view class="tip">赚没赚（两种算法，看你想看什么）</view>
      <input class="inp" placeholder="月份，如 2026-11（不填=本月）" value="{{pc_month}}" bindinput="onPcMonth"/>
      <button class="btn" size="mini" bindtap="loadProfitCompare">算一下</button>
      <view class="pc" wx:if="{{pc}}">
        <view class="pc-row">
          <view class="pc-t">手里钱变多没有？<text class="pc-s">（现金口径）</text></view>
