        </view>
        <view class="tip">点某一家 = 只复制那家的话；「存成图片」= 生成一张提醒卡，微信里可以直接转发给对方。</view>
      </view>

      <view class="form">
        <view class="tip">💬 报价单（先报个价，客户点头再转成单子，省得白干）</view>
        <view class="frow">
          <input class="inp half" placeholder="报给谁（客户）" value="{{qt_party}}" bindinput="onQtParty"/>
          <input class="inp half" placeholder="做什么（产品）" value="{{qt_item}}" bindinput="onQtItem"/>
