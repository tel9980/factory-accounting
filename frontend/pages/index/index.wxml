          <view class="row1"><text class="nm">{{item.customer}}{{item.item?'·'+item.item:''}}</text><text class="amt {{item.level=='high'?'red':''}}">{{item.idle_days}} 天没动</text></view>
          <view class="row2">{{item.status}}{{item.progress?' · '+item.progress:''}} · 最后动 {{item.last_day}} · ¥{{item.price}}</view>
        </view>
