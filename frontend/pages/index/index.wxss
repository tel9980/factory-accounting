.page { padding: 20rpx; background: #f5f6f8; min-height: 100vh; box-sizing: border-box; }
.stats { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.stat { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx; text-align: center; }
.stat .num { font-size: 34rpx; font-weight: 700; color: #1a1a1a; }
.stat .label { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.cards { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.card { flex: 1; background: #fff; border-radius: 12rpx; padding: 20rpx; }
.card .num { font-size: 40rpx; font-weight: 700; color: #e0711e; }
.card:last-child .num { color: #3d7bf5; }
.card .label { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.tabs { display: flex; background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 12rpx; }
.tab { flex: 1; text-align: center; padding: 14rpx 0; font-size: 23rpx; color: #666; white-space: nowrap; }
.tab.on { color: #3d7bf5; font-weight: 600; border-bottom: 4rpx solid #3d7bf5; }
.form { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.inp { flex: 1 1 40%; background: #f5f6f8; border-radius: 8rpx; padding: 12rpx; font-size: 26rpx; }
.picker { background: #f5f6f8; border-radius: 8rpx; padding: 12rpx 20rpx; font-size: 26rpx; }
.ta { width: 100%; height: 240rpx; background: #f5f6f8; border-radius: 8rpx; padding: 12rpx; font-size: 26rpx; box-sizing: border-box; }
.btn { background: #3d7bf5; color: #fff; }
.tip { width: 100%; font-size: 22rpx; color: #999; }
.list .item { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.nm { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.amt { font-size: 30rpx; font-weight: 700; color: #e0711e; }
.amt.out { color: #3d7bf5; }
.row2 { font-size: 24rpx; color: #888; margin: 8rpx 0; }
.btns { display: flex; gap: 12rpx; }
.btns button { font-size: 24rpx; }
.empty { text-align: center; color: #aaa; font-size: 26rpx; padding: 40rpx 0; }
.pre { white-space: pre-wrap; font-family: monospace; font-size: 22rpx; line-height: 1.6; color: #333; }
.seg { background: #f5f6f8; border-radius: 8rpx; padding: 12rpx 20rpx; font-size: 26rpx; color: #666; }
.seg.on { background: #3d7bf5; color: #fff; }
.amt.ok { color: #2a9d57; }
.biz { background: #fff; border-radius: 12rpx; padding: 14rpx 16rpx; margin-bottom: 12rpx; font-size: 24rpx; color: #1a1a1a; display: flex; justify-content: space-between; align-items: center; }
.biz-sub { color: #999; font-size: 20rpx; }
.overdue { background: #fdeaea; color: #c0392b; border-radius: 12rpx; padding: 14rpx 16rpx; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.duesoon { background: #fff6e0; color: #b8860b; border-radius: 12rpx; padding: 14rpx 16rpx; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 600; }
.chips { width: 100%; display: flex; flex-wrap: wrap; gap: 8rpx; align-items: center; }
.chip-label { font-size: 22rpx; color: #999; }
.chip { background: #eef2ff; color: #3d7bf5; border-radius: 8rpx; padding: 6rpx 14rpx; font-size: 24rpx; }
.chart { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; }
.chart-title { font-size: 26rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 12rpx; }
.bar-line { display: flex; align-items: center; gap: 8rpx; margin-bottom: 8rpx; }
.bar-m { width: 64rpx; font-size: 22rpx; color: #666; text-align: right; flex-shrink: 0; }
.bar-zone { flex: 1; display: flex; align-items: center; gap: 8rpx; }
.bar { height: 22rpx; border-radius: 6rpx; min-width: 2rpx; }
.bar-in { background: #3d7bf5; }
.bar-out { background: #e0711e; }
.bar-num { font-size: 20rpx; color: #888; width: 88rpx; flex-shrink: 0; }
.restore-ta { width: 100%; min-height: 120rpx; font-size: 24rpx; box-sizing: border-box; }
.report-canvas { position: fixed; left: -9999px; top: 0; width: 750px; height: 1200px; }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); z-index: 90; display: flex; align-items: center; justify-content: center; }
.modal { width: 86%; max-height: 78%; background: #fff; border-radius: 16rpx; padding: 24rpx; display: flex; flex-direction: column; }
.modal-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.modal-body { flex: 1; min-height: 200rpx; max-height: 60vh; }

/* 赚没赚两口径 */
.pc { margin-top: 12rpx; }
.pc-row { background: #fff; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.pc-t { font-size: 28rpx; font-weight: 600; color: #333; }
.pc-s { font-size: 22rpx; color: #999; font-weight: 400; }
.pc-n { font-size: 40rpx; font-weight: 700; margin: 8rpx 0; }
.pc-n.ok { color: #07a35a; }
.pc-n.bad { color: #e24032; }
.pc-sub { font-size: 24rpx; color: #888; line-height: 1.6; }
.pc-gap { font-size: 24rpx; color: #8a6d3b; background: #fdf6e3; border-radius: 10rpx; padding: 14rpx 18rpx; }

/* 首页四宫格（大字，一眼看清） */
.grid4 { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.g4 { width: calc(50% - 6rpx); box-sizing: border-box; background: #fff; border-radius: 14rpx; padding: 22rpx 18rpx; }
.g4n { font-size: 46rpx; font-weight: 700; color: #1a1a1a; line-height: 1.2; }
.g4n.red { color: #d93a3a; }
.g4n.green { color: #17a673; }
.g4l { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.monthline { font-size: 24rpx; color: #666; margin: 0 4rpx 12rpx; }
.topcust { background: #fff7e8; color: #a4620d; font-size: 24rpx; border-radius: 12rpx; padding: 12rpx 16rpx; margin-bottom: 12rpx; }
.btn.gray { background: #f1f2f4; color: #333; }
.btn.ghost { background: #eef3ff; color: #3d7bf5; }
.reimb { background: #f7f9ff; border: 1rpx solid #dbe6ff; border-radius: 10rpx; padding: 12rpx; margin: 12rpx 0; }

/* 全局搜索结果 */
.searchres { background: #fff; border-radius: 12rpx; padding: 8rpx 12rpx; margin-bottom: 12rpx; }
.searchres .item { padding: 10rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.tag { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-right: 8rpx; color: #fff; }
.tag-ar { background: #3d7bf5; }
.tag-ap { background: #f56c6c; }
.tag-ex { background: #e6a23c; }
/* 预算提示条 */
.budgetbar { background: #fff7e6; border-left: 6rpx solid #e6a23c; border-radius: 10rpx; padding: 14rpx 16rpx; margin-bottom: 12rpx; font-size: 24rpx; color: #8a5a00; line-height: 1.5; }
/* 常用短语 */
.btn-ghost { background: #f2f4f8; color: #3d7bf5; }

/* 账套条 */
.bookbar { background: #eef3ff; color: #2b5ecb; font-size: 24rpx; padding: 12rpx 16rpx; border-radius: 12rpx; margin-bottom: 12rpx; }

/* 加载更多 */
.loadmore { padding: 16rpx 0; text-align: center; }

.kpi-row { width: 100%; display: flex; justify-content: space-between; font-size: 26rpx; color: #1a1a1a; padding: 8rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.kpi-n { font-weight: 600; color: #3d7bf5; }
.kpi-n.ok { color: #2a9d57; }
.kpi-n.bad { color: #c0392b; }

/* 应收应付汇总条与筛选 */
.sumstrip { display: flex; flex-wrap: wrap; background: #fff; border-radius: 12rpx; padding: 12rpx 0; margin-bottom: 12rpx; }
.su { width: 25%; text-align: center; padding: 6rpx 0; }
.sun { font-size: 28rpx; font-weight: 600; color: #333; }
.sun.red { color: #e04b4b; }
.sun.org { color: #e08a1e; }
.sun.green { color: #2a9d5c; }
.sul { font-size: 19rpx; color: #999; margin-top: 4rpx; }
.chip.on { background: #3d7bf5; color: #fff; border-color: #3d7bf5; }
.chip-label { font-size: 22rpx; color: #999; margin-right: 8rpx; align-self: center; }
.detail-line { font-size: 24rpx; color: #444; padding: 5rpx 0; border-bottom: 1rpx solid #f2f2f2; }

/* 应收应付分组视图 */
.grp { margin: 16rpx 24rpx; background: #fff; border-radius: 14rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05); overflow: hidden; }
.grp-h { padding: 22rpx 24rpx; }
.grp-h .row1 .amt { color: #e64646; font-weight: 700; font-size: 30rpx; }
.grp-b { border-top: 1rpx solid #f0f0f0; background: #fafbfc; padding: 4rpx 0 14rpx; }
.gitem { padding: 16rpx 24rpx; border-bottom: 1rpx dashed #eee; }
.gitem:last-child { border-bottom: none; }
.grp-b .btns { padding: 12rpx 24rpx 0; }

/* 工作台式首页：一级导航 */
.mtabs { display: flex; background: #fff; border-radius: 12rpx; overflow: hidden; margin-bottom: 12rpx; }
.mtab { flex: 1; text-align: center; padding: 22rpx 0; font-size: 28rpx; color: #666; position: relative; }
.mtab.on { color: #1f6feb; font-weight: 700; }
.mtab.on::after { content: ''; position: absolute; left: 50%; bottom: 8rpx; transform: translateX(-50%); width: 44rpx; height: 6rpx; border-radius: 3rpx; background: #1f6feb; }
.subtabs { display: flex; background: #fff; border-radius: 12rpx; padding: 8rpx; margin-bottom: 12rpx; }
.sub { flex: 1; text-align: center; padding: 14rpx 0; font-size: 25rpx; color: #666; border-radius: 10rpx; }
.sub.on { background: #eaf2ff; color: #1f6feb; font-weight: 700; }
.sbadge { display: inline-block; margin-left: 6rpx; background: #e64646; color: #fff; font-size: 18rpx; line-height: 1; padding: 4rpx 8rpx; border-radius: 20rpx; vertical-align: top; }
/* 卡片 */
.card { background: #fff; border-radius: 14rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05); margin-bottom: 16rpx; padding: 20rpx 24rpx 8rpx; }
.card-h { font-size: 28rpx; font-weight: 700; color: #222; padding-bottom: 12rpx; }
.card-n { display: inline-block; margin-left: 12rpx; background: #e64646; color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 20rpx; }
/* 待办行 */
.todo { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #f2f3f5; }
.todo-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #f0a020; margin-right: 14rpx; flex: none; }
.todo.lv-red .todo-dot { background: #e64646; }
.todo.lv-gray .todo-dot { background: #b9bfc8; }
.todo-t { flex: 1; font-size: 26rpx; color: #333; line-height: 1.5; }
.todo-a { font-size: 24rpx; color: #1f6feb; flex: none; margin-left: 12rpx; }
/* 一句话记账紧排 */
.qinp { font-size: 28rpx; }
.qrow { display: flex; gap: 12rpx; margin-top: 12rpx; }
/* 常用宫格 */
.qgrid { display: flex; flex-wrap: wrap; padding: 8rpx 0 12rpx; }
.q { width: 25%; text-align: center; padding: 18rpx 0; }
.qi { width: 76rpx; height: 76rpx; line-height: 76rpx; margin: 0 auto 10rpx; border-radius: 24rpx; background: #eaf2ff; color: #1f6feb; font-size: 34rpx; }
.qn { font-size: 24rpx; color: #444; }

.alertbar { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(90deg,#ffe9e9,#fff4e6); border-left: 8rpx solid #e64646; border-radius: 12rpx; padding: 18rpx 20rpx; margin-bottom: 12rpx; }
.ab-t { flex: 1; font-size: 27rpx; font-weight: 700; color: #b02525; line-height: 1.45; }
.ab-a { font-size: 25rpx; color: #b02525; flex: none; margin-left: 12rpx; }
.todo-list { padding: 0 0 8rpx 26rpx; }
.todo-li { font-size: 23rpx; color: #666; line-height: 1.7; }
.todo-more { font-size: 22rpx; color: #1f6feb; padding-top: 4rpx; }

/* 开账引导 */
.ob { border: 2rpx solid #cfe0ff; }
.ob-tip { font-size: 24rpx; color: #667; line-height: 1.5; margin: 6rpx 0 10rpx; }
.ob-item { display: flex; align-items: center; padding: 14rpx 0; border-top: 1rpx solid #eef1f6; }
.ob-item.done { opacity: 0.62; }
.ob-dot { width: 40rpx; font-size: 30rpx; color: #b9bfc8; flex: none; }
.ob-item.done .ob-dot { color: #17a24b; }
.ob-body { flex: 1; }
.ob-t { font-size: 27rpx; color: #222; font-weight: 600; }
.ob-d { font-size: 23rpx; color: #888; margin-top: 2rpx; }
.ob-a { font-size: 24rpx; color: #1f6feb; flex: none; margin-left: 12rpx; }
.ob-item.done .ob-a { color: #17a24b; }
.ob-x { text-align: center; font-size: 23rpx; color: #99a; padding-top: 12rpx; }

/* 补录日期 */
.dateRow { display: flex; align-items: center; }
.datePick { flex: 1; }
.dateInp { background: #f5f6f8; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 26rpx; color: #333; margin: 8rpx 0; }
.dateClr { font-size: 22rpx; color: #1f6feb; padding: 0 10rpx; }

/* 现金流预测卡片 */
.cfcard { margin: 16rpx 0; padding: 20rpx 24rpx; background: #fff; border-radius: 16rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05); border-left: 8rpx solid #1f6feb; }
.cfh { font-size: 28rpx; font-weight: bold; color: #1f2937; margin-bottom: 10rpx; }
.cfl { font-size: 22rpx; color: #8a8f99; font-weight: normal; }
.cfrow { display: flex; justify-content: space-between; font-size: 26rpx; color: #444; padding: 4rpx 0; }
.cfrow .red { color: #d93025; }
.cfrow .green { color: #12805c; }
.cfwarn { margin-top: 10rpx; padding: 12rpx 16rpx; font-size: 24rpx; line-height: 1.5; color: #b45309; background: #fff7e6; border-radius: 10rpx; }
.cfwarn.ok { color: #12805c; background: #eaf7f0; }

/* 常用面额 */
.amts { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 4rpx 0 12rpx; }
.amt { padding: 8rpx 22rpx; font-size: 24rpx; color: #1f6feb; background: #eef4ff; border-radius: 999rpx; }

/* 数据自检红条 */
.issuebar { margin: 12rpx 0; padding: 16rpx 22rpx; background: #fdecea; color: #b3261e; border-radius: 12rpx; font-size: 25rpx; border-left: 8rpx solid #d93025; }

/* 借款台账 */
.debt-add { padding: 8rpx 0; }
.inp.half { flex: 1; width: auto; }
.rrow { display: flex; gap: 12rpx; }
.frow { display: flex; gap: 10rpx; margin: 10rpx 0; }
.frow .picker { flex: 1; background: #f5f6f8; border-radius: 8rpx; padding: 12rpx; font-size: 26rpx; color: #333; }

/* 导入预览 / 对账核对 */
.prev { margin-top: 16rpx; padding: 20rpx; background: #fff; border: 2rpx solid #e6e6e6; border-radius: 12rpx; }
.prev-h { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
.prev-row { display: flex; align-items: center; padding: 10rpx 0; border-bottom: 1rpx solid #f2f2f2; font-size: 26rpx; }
.prev-ok { width: 36rpx; }
.prev-t { flex: 1; margin-right: 12rpx; }
.prev-n { color: #666; }
.prev-row .ok { color: #12a150; }
.prev-row .red { color: #d93026; }

/* 手机报表预览 */
.plrow { display: flex; align-items: center; padding: 8rpx 4rpx; border-bottom: 1rpx solid #f0f0f0; font-size: 26rpx; }
.pll { flex: 1; color: #333; }
.pll.strong { font-weight: 700; }
.plv { min-width: 160rpx; text-align: right; color: #333; }
.plv.ok { color: #1a7f37; }
.plv.bad { color: #c62828; }
.aline { padding: 12rpx 16rpx; margin: 8rpx 0; border-radius: 8rpx; font-size: 24rpx; line-height: 1.5; }
.aline.bad { background: #fdecec; color: #a51e1e; border-left: 6rpx solid #e53935; }
.aline.warn { background: #fff6e5; color: #8a5a00; border-left: 6rpx solid #f0a020; }
.aline.ok { background: #eef8ef; color: #1a7f37; border-left: 6rpx solid #43a047; }
.ybar { width: 200rpx; height: 16rpx; background: #f2f2f2; border-radius: 8rpx; margin-left: 12rpx; overflow: hidden; }
.ybar-in { height: 16rpx; background: #2f6fed; border-radius: 8rpx; }
.ybar-in.bad { background: #e53935; }

/* 月度目标 */
.goalcard { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 16rpx 0; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
.goalh { font-size: 26rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.goalbar { height: 20rpx; background: #eef1f5; border-radius: 10rpx; overflow: hidden; }
.goalbar-in { height: 20rpx; background: #2f6fed; border-radius: 10rpx; transition: width .3s; }
.goalbar-in.done { background: #43a047; }
.goalrow { display: flex; justify-content: space-between; font-size: 24rpx; color: #444; margin-top: 10rpx; }
.goalsub { font-size: 22rpx; color: #888; margin-top: 8rpx; line-height: 1.5; }
.goalform { background: #fff; border-radius: 12rpx; padding: 20rpx 24rpx; margin: 16rpx 0; }
/* 趋势条 */
.trow { display: flex; align-items: center; padding: 6rpx 0; font-size: 24rpx; }
.tlabel { width: 90rpx; color: #666; }
.tbar { flex: 1; height: 26rpx; background: #f2f4f7; border-radius: 6rpx; margin: 0 12rpx; overflow: hidden; }
.tbar-in { height: 26rpx; background: #2f6fed; border-radius: 6rpx; }
.tbar-in.bad { background: #e53935; }
.tval { width: 130rpx; text-align: right; }

/* 本月财务流程（流水线） */
.pipe-row { display:flex; align-items:center; padding:10rpx 0; border-bottom:1rpx solid #f2f2f2; }
.pipe-row:last-child { border-bottom:none; }
.pipe-dot { width:40rpx; height:40rpx; line-height:40rpx; text-align:center; border-radius:20rpx; background:#eef1f5; color:#8a94a6; font-size:24rpx; margin-right:14rpx; }
.pipe-row.done .pipe-dot { background:#e6f7ec; color:#18a05a; }
.pipe-row.now .pipe-dot { background:#fff2dd; color:#e08a12; }
.pipe-body { flex:1; }
.pipe-t { font-size:28rpx; color:#222; }
.pipe-row.done .pipe-t { color:#8a94a6; }
.pipe-d { font-size:23rpx; color:#8a94a6; margin-top:2rpx; }
.pipe-a { font-size:24rpx; color:#2b6cf6; }
.pipe-row.done .pipe-a { color:#c8ccd4; }

/* 首页账本健康条 + 面板 */
.hstrip { display:flex; align-items:center; justify-content:space-between; border-radius:12rpx; padding:16rpx 20rpx; margin-bottom:12rpx; background:#eef6ff; border-left:8rpx solid #3b7ddd; }
.hstrip.good { background:#eaf7ee; border-left-color:#2f9e44; }
.hstrip.mid { background:#fff8e6; border-left-color:#e6a23c; }
.hstrip.bad { background:#ffecec; border-left-color:#e64646; }
.hs-l { display:flex; align-items:baseline; }
.hs-score { font-size:40rpx; font-weight:700; color:#222; }
.hs-unit { font-size:22rpx; color:#666; margin-left:2rpx; }
.hs-grade { font-size:24rpx; color:#555; margin-left:12rpx; }
.hs-delta { font-size:22rpx; margin-left:10rpx; color:#2f9e44; }
.hs-delta.down { color:#e64646; }
.hs-r { font-size:24rpx; color:#666; }
.hk-row { display:flex; align-items:center; justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid #f0f0f0; }
.hk-main { flex:1; padding-right:12rpx; }
.hk-t { font-size:27rpx; color:#222; }
.hk-t.ok { color:#2f9e44; }
.hk-n { font-size:22rpx; color:#e64646; margin-left:10rpx; }
.hk-d { font-size:22rpx; color:#888; margin-top:4rpx; line-height:1.5; }
.hk-a { font-size:24rpx; color:#3b7ddd; }

/* 争议台账时间线 */
.tl { display:flex; padding:8rpx 0; border-left:3rpx solid #e6e6e6; margin-left:6rpx; padding-left:14rpx; }
.tl-d { font-size:22rpx; color:#999; width:130rpx; flex:none; }
.tl-t { font-size:24rpx; color:#333; flex:1; line-height:1.5; }

/* 我的活 */
.mwrow { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.mwdot { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 8rpx; background: #eef4ff; color: #2b6cb0; font-size: 22rpx; margin-right: 12rpx; flex: none; }
.mwdot.red { background: #fff1f0; color: #d64545; }
.mwmain { flex: 1; font-size: 26rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mwside { font-size: 24rpx; color: #888; flex: none; margin-left: 10rpx; }
.mwside.red, .red { color: #d64545; }
/* 一页纸帮助 */
.help-h { font-size: 28rpx; font-weight: 600; color: #2b6cb0; margin: 18rpx 0 8rpx; }
.help-p { font-size: 25rpx; color: #444; line-height: 1.7; margin-bottom: 6rpx; }
.sheet-x { float: right; font-size: 30rpx; color: #999; padding: 0 6rpx; }

.pbtext { background:#f8fafc; border:1px solid #e6eaf0; border-radius:10rpx; padding:16rpx 20rpx; font-size:25rpx; color:#334155; line-height:1.7; white-space:pre-wrap; }

/* 功能地图 */
.mapg { margin-top: 12rpx; }
.mapt { font-size: 26rpx; color: #8a8f99; margin: 16rpx 0 6rpx; }
.maprow { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.mapl { flex: 1; }
.mapa { color: #b9bec7; font-size: 34rpx; padding-left: 12rpx; }

/* 断网时存到手机上的记录，提醒条 */
.pendbar { margin: 8rpx 20rpx; padding: 14rpx 18rpx; background: #fff4e5; color: #a35b00; border: 1rpx solid #ffd699; border-radius: 12rpx; font-size: 25rpx; }

/* 现在先做这一件 */
.nscard { margin:16rpx 24rpx; padding:24rpx 28rpx; border-radius:18rpx;
  background:linear-gradient(135deg,#2f6fed,#4f9bff); color:#fff; box-shadow:0 6rpx 18rpx rgba(47,111,237,.25); }
.ns-k { font-size:24rpx; opacity:.9; }
.ns-t { font-size:38rpx; font-weight:700; margin:8rpx 0 6rpx; }
.ns-w { font-size:26rpx; line-height:1.5; opacity:.95; }
.ns-r { margin-top:14rpx; font-size:28rpx; font-weight:600; text-align:right; }
.ns-more { font-size:24rpx; font-weight:400; opacity:.85; }
.nsnone { margin:16rpx 24rpx; padding:20rpx 24rpx; border-radius:14rpx; background:#eef7ee; color:#2f7d32; font-size:26rpx; }

/* 今天的活：一条重点 + 明细 */
.mwrow.pri { background: #f5f9ff; border-radius: 8rpx; padding: 12rpx 10rpx; align-items: flex-start; }
.mwdot.blue { background: #2f6df6; color: #fff; }
.mwmain2 { flex: 1; display: flex; flex-direction: column; }
.ns-t2 { font-size: 26rpx; color: #1a1a1a; font-weight: 600; }
.ns-w2 { font-size: 22rpx; color: #666; margin-top: 4rpx; }

/* 「今天的活」展开后的其它事项 */
.ns-alltip { font-size: 22rpx; color: #8a94a6; padding: 8rpx 20rpx 4rpx; }
.mwrow.nso { padding-top: 10rpx; padding-bottom: 10rpx; }

/* 月底收尾提示行 */
.mwrow.mtip { background: #fff8ec; }
