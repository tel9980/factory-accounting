.container {
  padding: 24rpx;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.summary text {
  font-size: 34rpx;
  font-weight: bold;
  color: #d4380d;
}
.form input {
  border: 1rpx solid #e5e5e5;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
}
.order-item {
  border-bottom: 1rpx solid #f0f0f0;
  padding: 20rpx 0;
}
.order-item:last-child {
  border-bottom: none;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.row.sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #888;
}
