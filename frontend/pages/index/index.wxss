.page { padding: 20rpx 24rpx 60rpx; background: #f4f5f7; min-height: 100vh; box-sizing: border-box; }

.stats { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.stat { flex: 1; background: #fff; border-radius: 16rpx; padding: 24rpx 12rpx; text-align: center; }
.stat .num { font-size: 40rpx; font-weight: 700; color: #1a1a1a; }
.stat .num.profit { color: #07c160; }
.stat .label { font-size: 22rpx; color: #888; margin-top: 6rpx; }

.cards { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.card { flex: 1; background: #fff; border-radius: 16rpx; padding: 28rpx 16rpx; text-align: center; }
.card.warn { background: #fff7e6; }
.card .num { font-size: 52rpx; font-weight: 700; color: #fa8c16; }
.card .label { font-size: 22rpx; color: #888; margin-top: 8rpx; }

.section-title { font-size: 26rpx; font-weight: 600; color: #555; margin: 20rpx 4rpx 12rpx; }

.form { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 16rpx; display: flex; flex-wrap: wrap; gap: 16rpx; align-items: center; }
.form input { flex: 1 1 40%; min-width: 220rpx; background: #f7f8fa; border-radius: 10rpx; padding: 14rpx 16rpx; font-size: 26rpx; }
.form .picker { background: #f7f8fa; border-radius: 10rpx; padding: 14rpx 16rpx; font-size: 26rpx; color: #333; }
.form button { margin-left: auto; }

.orders { display: flex; flex-direction: column; gap: 16rpx; }
.order { background: #fff; border-radius: 16rpx; padding: 20rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.cust { font-size: 30rpx; font-weight: 600; }
.status { font-size: 22rpx; color: #1677ff; background: #e8f1ff; padding: 4rpx 14rpx; border-radius: 20rpx; }
.row2 { font-size: 24rpx; color: #666; margin: 10rpx 0; }
.row3 { display: flex; justify-content: space-between; align-items: center; }
.pay { font-size: 24rpx; color: #fa8c16; }
.btns { display: flex; gap: 12rpx; }

.empty { text-align: center; color: #aaa; font-size: 26rpx; padding: 40rpx 0; }
